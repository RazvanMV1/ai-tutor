@page "/ai/problems"
@inject AiService AiService
@inject AuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>Probleme AI - AI Tutor</PageTitle>

<RedirectToLogin />

<!-- Header -->
<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-6"
                  Style="border-radius:16px;
                         background:linear-gradient(135deg,#E65100 0%,#F57C00 50%,#FFB74D 100%);">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Psychology"
                         Style="font-size:2.5rem; color:white;" />
                <div>
                    <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">
                        Generator de Probleme AI
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.85);">
                        Practică cu probleme generate automat, cu indicii și soluții
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid>
    <!-- Formular stânga -->
    <MudItem xs="12" md="4">
        <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
            <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" />
                Configurare
            </MudText>

            <MudSelect @bind-Value="_subject"
                       Label="Materie"
                       Variant="Variant.Outlined"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.MenuBook"
                       AdornmentColor="Color.Primary"
                       Class="mb-4"
                       FullWidth="true">
                <MudSelectItem Value="1">📐 Matematică</MudSelectItem>
                <MudSelectItem Value="2">📖 Română</MudSelectItem>
                <MudSelectItem Value="3">💻 Informatică</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_difficulty"
                       Label="Nivel dificultate"
                       Variant="Variant.Outlined"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.SignalCellularAlt"
                       AdornmentColor="Color.Secondary"
                       Class="mb-4"
                       FullWidth="true">
                <MudSelectItem Value="1">🟢 Începător</MudSelectItem>
                <MudSelectItem Value="2">🟡 Intermediar</MudSelectItem>
                <MudSelectItem Value="3">🔴 Avansat</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_topic"
                          Label="Subiect / Topic"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          Placeholder="ex: ecuații, substantiv, sortare..."
                          Lines="2"
                          Class="mb-4"
                          FullWidth="true" />

            <MudText Typo="Typo.body2" Class="mb-1">
                Vârsta elevului:
                <strong style="color:#1976D2;">@_studentAge ani</strong>
            </MudText>
            <MudSlider @bind-Value="_studentAge"
                       Min="6" Max="18" Step="1"
                       Color="Color.Primary"
                       Class="mb-4" />

            <MudText Typo="Typo.body2" Class="mb-1">
                Număr de probleme:
                <strong style="color:#F57C00;">@_count</strong>
            </MudText>
            <MudSlider @bind-Value="_count"
                       Min="1" Max="5" Step="1"
                       Color="Color.Warning"
                       Class="mb-4" />

            <!-- Indicator număr probleme -->
            <div class="d-flex justify-space-around mb-4">
                @for (int i = 1; i <= 5; i++)
                {
                    var index = i;
                    <div style="@($"width:32px; height:32px; border-radius:50%; background:{(index <= _count ? "#F57C00" : "#E0E0E0")}; display:flex; align-items:center; justify-content:center; color:{(index <= _count ? "white" : "#9E9E9E")}; font-weight:600; font-size:0.85rem; transition:background 0.3s ease;")">
                        @index
                    </div>
                }
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Psychology"
                       Disabled="@(_isLoading || string.IsNullOrWhiteSpace(_topic))"
                       OnClick="GenerateProblems"
                       Style="border-radius:8px; height:48px;">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small"
                                        Indeterminate="true"
                                        Class="mr-2" />
                    <span>Se generează...</span>
                }
                else
                {
                    <span>🧠 Generează Probleme</span>
                }
            </MudButton>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 mb-2">
                Exemple rapide:
            </MudText>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var ex in _quickExamples)
                {
                    <MudChip T="string"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Color="Color.Warning"
                             OnClick="@(() => SetQuickExample(ex))">
                        @ex
                    </MudChip>
                }
            </div>
        </MudPaper>
    </MudItem>

    <!-- Rezultate dreapta -->
    <MudItem xs="12" md="8">
        @if (_problems is null && !_isLoading)
        {
            <MudPaper Elevation="1" Class="pa-8"
                      Style="border-radius:12px; border:2px dashed #E0E0E0; background:#FAFAFA;">
                <div class="d-flex flex-column align-center justify-center"
                     style="min-height:300px;">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology"
                             Style="font-size:4rem; color:#E0E0E0;" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-3">
                        Problemele tale vor apărea aici
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary"
                             Align="Align.Center" Class="mt-1">
                        Configurează și apasă "Generează Probleme"
                    </MudText>
                </div>
            </MudPaper>
        }
        else if (_isLoading)
        {
            <MudPaper Elevation="2" Class="pa-8" Style="border-radius:12px;">
                <div class="d-flex flex-column align-center justify-center"
                     style="min-height:300px;">
                    <MudProgressCircular Color="Color.Warning"
                                        Indeterminate="true"
                                        Size="Size.Large" />
                    <MudText Typo="Typo.body1" Color="Color.Warning" Class="mt-4">
                        AI-ul generează problemele...
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Acest lucru poate dura câteva secunde
                    </MudText>
                </div>
            </MudPaper>
        }
        else if (_problems is not null)
        {
            <div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6" Color="Color.Primary">
                        Probleme: <strong>@_problems.Topic</strong>
                    </MudText>
                    <MudChip T="string" Size="Size.Small"
                             Color="Color.Warning" Variant="Variant.Filled">
                        @_problems.Problems.Count probleme
                    </MudChip>
                </div>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Success"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="RevealAllSolutions">
                        Toate soluțiile
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="ResetReveal">
                        Resetează
                    </MudButton>
                </div>
            </div>

            <MudExpansionPanels MultiExpansion="true">
                @for (int i = 0; i < _problems.Problems.Count; i++)
                {
                    var index = i;
                    <MudExpansionPanel Class="mb-2"
                                       Style="border-radius:12px; overflow:hidden;">
                        <TitleContent>
                            <div class="d-flex align-center gap-3 w-100">
                                <div style="width:36px; height:36px; border-radius:50%;
                                            background:#F57C00; color:white;
                                            display:flex; align-items:center;
                                            justify-content:center; font-weight:700;
                                            flex-shrink:0;">
                                    @(index + 1)
                                </div>
                                <MudText Typo="Typo.body1"
                                         Style="flex:1; overflow:hidden;
                                                text-overflow:ellipsis; white-space:nowrap;">
                                    @(GetPreview(_problems.Problems[index]))
                                </MudText>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    @if (_shownHints.Contains(index))
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="Color.Info"
                                                 Variant="Variant.Filled">
                                            Indiciu
                                        </MudChip>
                                    }
                                    @if (_shownSolutions.Contains(index))
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="Color.Success"
                                                 Variant="Variant.Filled">
                                            Soluție
                                        </MudChip>
                                    }
                                </div>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div class="pa-2">
                                <MudPaper Elevation="0" Class="pa-4 mb-3"
                                          Style="background:#F5F5F5; border-radius:8px;">
                                    <MudText Typo="Typo.body1" Style="line-height:1.7;">
                                        @_problems.Problems[index]
                                    </MudText>
                                </MudPaper>

                                <div class="d-flex gap-2 flex-wrap mb-3">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Info"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Lightbulb"
                                               OnClick="@(() => ToggleHint(index))">
                                        @(_shownHints.Contains(index)
                                            ? "Ascunde indiciu"
                                            : "Arată indiciu")
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CheckCircle"
                                               OnClick="@(() => ToggleSolution(index))">
                                        @(_shownSolutions.Contains(index)
                                            ? "Ascunde soluția"
                                            : "Arată soluția")
                                    </MudButton>
                                </div>

                                @if (_shownHints.Contains(index) &&
                                     _problems.Hints is not null &&
                                     index < _problems.Hints.Count)
                                {
                                    <MudAlert Severity="Severity.Info"
                                              Class="mb-3"
                                              Style="border-radius:8px;">
                                        <MudText Typo="Typo.body2">
                                            <strong>💡 Indiciu:</strong>
                                            @_problems.Hints[index]
                                        </MudText>
                                    </MudAlert>
                                }

                                @if (_shownSolutions.Contains(index) &&
                                     _problems.Solutions is not null &&
                                     index < _problems.Solutions.Count)
                                {
                                    <MudAlert Severity="Severity.Success"
                                              Class="mb-3"
                                              Style="border-radius:8px;">
                                        <MudText Typo="Typo.body2">
                                            <strong>✅ Soluție:</strong>
                                            @_problems.Solutions[index]
                                        </MudText>
                                    </MudAlert>
                                }
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>

            <MudPaper Elevation="1" Class="pa-4 mt-3"
                      Style="border-radius:12px; background:#FFF8E1;">
                <div class="d-flex justify-space-around flex-wrap gap-2">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment"
                                 Color="Color.Warning" Size="Size.Small" />
                        <MudText Typo="Typo.body2">
                            Total: <strong>@_problems.Problems.Count</strong>
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.Lightbulb"
                                 Color="Color.Info" Size="Size.Small" />
                        <MudText Typo="Typo.body2">
                            Indicii văzute: <strong>@_shownHints.Count</strong>
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                 Color="Color.Success" Size="Size.Small" />
                        <MudText Typo="Typo.body2">
                            Soluții văzute: <strong>@_shownSolutions.Count</strong>
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private int    _subject    = 1;
    private int    _difficulty = 1;
    private string _topic      = string.Empty;
    private int    _studentAge = 12;
    private int    _count      = 3;

    private bool             _isLoading = false;
    private ProblemResponse? _problems  = null;

    private readonly HashSet<int> _shownHints     = [];
    private readonly HashSet<int> _shownSolutions = [];

    private readonly string[] _quickExamples =
    [
        "Ecuații",
        "Fracții",
        "Geometrie",
        "Substantivul",
        "Verbul",
        "Vectori C++",
        "Recursivitate",
        "Șiruri de caractere"
    ];

    private void SetQuickExample(string example)
    {
        _topic    = example;
        _problems = null;
        _shownHints.Clear();
        _shownSolutions.Clear();
    }

    private async Task GenerateProblems()
    {
        if (string.IsNullOrWhiteSpace(_topic)) return;

        _isLoading = true;
        _problems  = null;
        _shownHints.Clear();
        _shownSolutions.Clear();

        try
        {
            _problems = await AiService.GetProblemsAsync(
                new ProblemRequest(_topic, _subject, _difficulty, _studentAge, _count));

            Snackbar.Add($"{_problems.Problems.Count} probleme generate cu succes! 🧠",
                         Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la generarea problemelor: {ex.Message}", Severity.Error);

            _problems = new ProblemResponse(
                Topic: _topic,
                Problems:
                [
                    $"Problema 1 demo despre {_topic}: Calculează rezultatul operației.",
                    $"Problema 2 demo despre {_topic}: Analizează și explică conceptul.",
                    $"Problema 3 demo despre {_topic}: Aplică formula în acest caz."
                ],
                Hints:
                [
                    "Indiciu 1: Începe cu definirea variabilelor.",
                    "Indiciu 2: Folosește proprietățile de bază.",
                    "Indiciu 3: Verifică rezultatul final."
                ],
                Solutions:
                [
                    "Soluție 1: Răspunsul este 42. Rezolvare detaliată demo.",
                    "Soluție 2: Răspunsul corect implică aplicarea regulii de bază.",
                    "Soluție 3: Rezultatul final se obține prin calcul direct."
                ],
                Subject: _subject,
                DifficultyLevel: _difficulty
            );
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleHint(int index)
    {
        if (!_shownHints.Add(index))
            _shownHints.Remove(index);
    }

    private void ToggleSolution(int index)
    {
        if (!_shownSolutions.Add(index))
            _shownSolutions.Remove(index);
    }

    private void RevealAllSolutions()
    {
        if (_problems is null) return;
        for (int i = 0; i < _problems.Problems.Count; i++)
            _shownSolutions.Add(i);
    }

    private void ResetReveal()
    {
        _shownHints.Clear();
        _shownSolutions.Clear();
    }

    private static string GetPreview(string text)
        => text.Length > 80 ? text[..80] + "..." : text;
}