@page "/subjects"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Materii - AI Tutor</PageTitle>

<RedirectToLogin />

<!-- Header -->
<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-6"
                  Style="border-radius:16px;
                         background:linear-gradient(135deg,#1B5E20 0%,#388E3C 50%,#66BB6A 100%);">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                         Style="font-size:2.5rem; color:white;" />
                <div>
                    <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">
                        Materiile Mele
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.85);">
                        Selectează o materie pentru a vedea lecțiile disponibile
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_isLoading)
{
    <MudGrid>
        @for (int i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle"
                             Height="200px"
                             Style="border-radius:16px;" />
            </MudItem>
        }
    </MudGrid>
}
else
{
    <!-- Grid materii -->
    <MudGrid Class="mb-6">
        @foreach (var subject in _subjects)
        {
            var config = GetSubjectConfig(subject.Type);
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3"
                         Style="@($"border-radius:16px; cursor:pointer; border-top:5px solid {config.Color}; transition:transform 0.2s ease, box-shadow 0.2s ease;")"
                         @onclick="@(() => SelectSubject(subject))"
                         Class="@(_selectedSubject?.Id == subject.Id ? "selected-card" : "")">
                    <MudCardContent Class="pa-6">
                        <div class="d-flex justify-space-between align-start mb-4">
                            <div style="@($"width:64px; height:64px; border-radius:16px; background:{config.LightColor}; display:flex; align-items:center; justify-content:center; font-size:2rem;")">
                                @config.Emoji
                            </div>
                            @if (_selectedSubject?.Id == subject.Id)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="Color.Primary"
                                         Variant="Variant.Filled">
                                    Selectată
                                </MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.h6" Style="font-weight:700;" Class="mb-1">
                            @subject.Name
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            @subject.Description
                        </MudText>

                        <MudDivider Class="mb-3" />

                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.AutoStories"
                                         Size="Size.Small"
                                         Style="@($"color:{config.Color};")" />
                                <MudText Typo="Typo.caption"
                                         Style="@($"color:{config.Color}; font-weight:600;")">
                                    Vezi lecții
                                </MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                     Style="@($"color:{config.Color};")" />
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <!-- Lista lecții -->
    @if (_selectedSubject is not null)
    {
        var config = GetSubjectConfig(_selectedSubject.Type);

        <MudPaper Elevation="2" Class="pa-5" Style="border-radius:16px;">
            <!-- Header lecții -->
            <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
                <div class="d-flex align-center gap-2">
                    <span style="font-size:1.5rem;">@config.Emoji</span>
                    <MudText Typo="Typo.h6" Style="font-weight:700;">
                        Lecții — @_selectedSubject.Name
                    </MudText>
                    <MudChip T="string" Size="Size.Small"
                             Style="@($"background:{config.LightColor}; color:{config.Color};")"
                             Variant="Variant.Filled">
                        @_lessons.Count lecții
                    </MudChip>
                </div>

                <!-- Filtre dificultate -->
                <div class="d-flex gap-1 flex-wrap">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_filterDifficulty == 0 ? Color.Primary : Color.Default)"
                             Variant="@(_filterDifficulty == 0 ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _filterDifficulty = 0)">
                        Toate
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_filterDifficulty == 1 ? Color.Success : Color.Default)"
                             Variant="@(_filterDifficulty == 1 ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _filterDifficulty = 1)">
                        🟢 Începător
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_filterDifficulty == 2 ? Color.Warning : Color.Default)"
                             Variant="@(_filterDifficulty == 2 ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _filterDifficulty = 2)">
                        🟡 Intermediar
                    </MudChip>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(_filterDifficulty == 3 ? Color.Error : Color.Default)"
                             Variant="@(_filterDifficulty == 3 ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => _filterDifficulty = 3)">
                        🔴 Avansat
                    </MudChip>
                </div>
            </div>

            @if (_isLessonsLoading)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Color="Color.Primary"
                                        Indeterminate="true" />
                </div>
            }
            else if (!FilteredLessons.Any())
            {
                <div class="d-flex flex-column align-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                             Style="font-size:3rem; color:#BDBDBD;" />
                    <MudText Color="Color.Secondary" Class="mt-2">
                        Nu există lecții pentru filtrul selectat.
                    </MudText>
                </div>
            }
            else
            {
                <MudGrid>
                    @foreach (var lesson in FilteredLessons)
                    {
                        var isCompleted = IsLessonCompleted(lesson.Id);
                        var score       = GetLessonScore(lesson.Id);

                        <MudItem xs="12" sm="6" lg="4">
                            <MudCard Elevation="1"
                                     Style="@($"border-radius:12px; border-left:4px solid {GetDifficultyColor(lesson.Difficulty)}; transition:box-shadow 0.2s;")">
                                <MudCardContent Class="pa-4">
                                    <!-- Header lecție -->
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Style="@($"background:{GetDifficultyBg(lesson.Difficulty)}; color:{GetDifficultyColor(lesson.Difficulty)};")"
                                                 Variant="Variant.Filled">
                                            @GetDifficultyName(lesson.Difficulty)
                                        </MudChip>

                                        @if (isCompleted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                     Color="Color.Success"
                                                     Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.RadioButtonUnchecked"
                                                     Color="Color.Default"
                                                     Size="Size.Small" />
                                        }
                                    </div>

                                    <!-- Număr ordine + Titlu -->
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <div style="@($"width:28px; height:28px; border-radius:50%; background:{config.LightColor}; color:{config.Color}; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; flex-shrink:0;")">
                                            @lesson.OrderIndex
                                        </div>
                                        <MudText Typo="Typo.subtitle2"
                                                 Style="font-weight:600; line-height:1.3;">
                                            @lesson.Title
                                        </MudText>
                                    </div>

                                    <!-- Preview content -->
                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary"
                                             Class="mb-3"
                                             Style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                        @lesson.Content
                                    </MudText>

                                    <!-- Score dacă completat -->
                                    @if (isCompleted)
                                    {
                                        <MudProgressLinear Value="@score"
                                                           Color="Color.Success"
                                                           Rounded="true"
                                                           Size="Size.Small"
                                                           Class="mb-2" />
                                        <MudText Typo="Typo.caption"
                                                 Style="color:#388E3C;">
                                            Scor: <strong>@score%</strong>
                                        </MudText>
                                    }
                                </MudCardContent>

                                <MudCardActions Class="pa-3 pt-0">
                                    <MudButton Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Style="@($"background:{config.Color}; color:white; border-radius:8px;")"
                                               StartIcon="@(isCompleted
                                                   ? Icons.Material.Filled.Replay
                                                   : Icons.Material.Filled.PlayArrow)"
                                               OnClick="@(() => OpenLesson(lesson))">
                                        @(isCompleted ? "Reface" : "Începe")
                                    </MudButton>

                                    <MudSpacer />

                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @lesson.CreatedAt.ToString("dd MMM yyyy")
                                    </MudText>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }
}

<!-- Dialog lecție -->
<MudDialog @bind-Visible="_lessonDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories"
                     Color="Color.Primary" />
            <MudText Typo="Typo.h6">@_selectedLesson?.Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedLesson is not null)
        {
            <div class="mb-3 d-flex gap-2 flex-wrap">
                <MudChip T="string" Size="Size.Small"
                         Color="@GetDifficultyChipColor(_selectedLesson.Difficulty)"
                         Variant="Variant.Filled">
                    @GetDifficultyName(_selectedLesson.Difficulty)
                </MudChip>
                <MudChip T="string" Size="Size.Small"
                         Color="Color.Primary" Variant="Variant.Outlined">
                    Lecția @_selectedLesson.OrderIndex
                </MudChip>
            </div>

            <MudText Typo="Typo.body1" Style="line-height:1.8; white-space:pre-wrap;">
                @_selectedLesson.Content
            </MudText>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">
                Marchează ca finalizată:
            </MudText>

            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.body2">
                    Scorul tău: <strong>@_completionScore%</strong>
                </MudText>
            </div>
            <MudSlider @bind-Value="_completionScore"
                       Min="0" Max="100" Step="5"
                       Color="Color.Success"
                       Class="mb-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseLesson" Color="Color.Default">
            Închide
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   Disabled="_isCompleting"
                   OnClick="CompleteLesson">
            @if (_isCompleting)
            {
                <MudProgressCircular Size="Size.Small"
                                    Indeterminate="true"
                                    Class="mr-2" />
            }
            Marchează finalizată
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool              _isLoading       = true;
    private bool              _isLessonsLoading = false;
    private bool              _isCompleting    = false;
    private List<SubjectDto>  _subjects        = [];
    private List<LessonDto>   _lessons         = [];
    private SubjectDto?       _selectedSubject = null;
    private LessonDto?        _selectedLesson  = null;
    private int               _filterDifficulty = 0;
    private List<StudentProgressDto> _progress = [];

    // Dialog
    private bool   _lessonDialogOpen = false;
    private int    _completionScore  = 80;
    private DialogOptions _dialogOptions = new()
    {
        MaxWidth     = MaxWidth.Medium,
        FullWidth    = true,
        CloseButton  = true
    };

    private IEnumerable<LessonDto> FilteredLessons =>
        _filterDifficulty == 0
            ? _lessons
            : _lessons.Where(l => l.Difficulty == _filterDifficulty);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadSubjectsAsync();
    }

    private async Task LoadSubjectsAsync()
    {
        try
        {
            _subjects = await ApiService.GetSubjectsAsync();

            if (_subjects.Count == 0)
                LoadDemoSubjects();
        }
        catch
        {
            LoadDemoSubjects();
            Snackbar.Add("Backend indisponibil — se afișează date demo.", Severity.Info);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectSubject(SubjectDto subject)
    {
        _selectedSubject  = subject;
        _filterDifficulty = 0;
        _isLessonsLoading = true;
        StateHasChanged();

        try
        {
            // Încarcă progresul userului
            var user = await AuthService.GetUserAsync();
            if (user is not null)
                _progress = await ApiService.GetProgressAsync(user.Id);

            // Demo lecții per materie
            _lessons = GetDemoLessons(subject.Type);
        }
        catch
        {
            _lessons = GetDemoLessons(subject.Type);
        }
        finally
        {
            _isLessonsLoading = false;
            StateHasChanged();
        }
    }

    private void OpenLesson(LessonDto lesson)
    {
        _selectedLesson  = lesson;
        _completionScore = 80;
        _lessonDialogOpen = true;
    }

    private void CloseLesson()
    {
        _lessonDialogOpen = false;
        _selectedLesson   = null;
    }

    private async Task CompleteLesson()
    {
        if (_selectedLesson is null) return;

        _isCompleting = true;
        try
        {
            var user = await AuthService.GetUserAsync();
            if (user is not null)
            {
                await ApiService.CompleteLessonAsync(
                    new CompleteLessonRequest(user.Id, _selectedLesson.Id,
                        _completionScore));
            }

            Snackbar.Add($"Lecție finalizată cu scorul {_completionScore}%! 🎉",
                         Severity.Success);
            CloseLesson();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Warning);
            CloseLesson();
        }
        finally
        {
            _isCompleting = false;
        }
    }

    private bool IsLessonCompleted(Guid lessonId)
        => _progress.Any(p => p.LessonId == lessonId && p.IsCompleted);

    private int GetLessonScore(Guid lessonId)
        => _progress.FirstOrDefault(p => p.LessonId == lessonId)?.ScorePercentage ?? 0;

    // ── Config materii ────────────────────────────────────────────────────────
    private record SubjectConfig(string Color, string LightColor, string Emoji);

    private static SubjectConfig GetSubjectConfig(int type) => type switch
    {
        1 => new("#1976D2", "#E3F2FD", "📐"),
        2 => new("#388E3C", "#E8F5E9", "📖"),
        3 => new("#7B1FA2", "#F3E5F5", "💻"),
        _ => new("#757575", "#F5F5F5", "📚")
    };

    // ── Difficulty helpers ────────────────────────────────────────────────────
    private static string GetDifficultyName(int d) => d switch
    {
        1 => "🟢 Începător",
        2 => "🟡 Intermediar",
        3 => "🔴 Avansat",
        _ => "Necunoscut"
    };

    private static string GetDifficultyColor(int d) => d switch
    {
        1 => "#388E3C",
        2 => "#F57C00",
        3 => "#D32F2F",
        _ => "#757575"
    };

    private static string GetDifficultyBg(int d) => d switch
    {
        1 => "#E8F5E9",
        2 => "#FFF3E0",
        3 => "#FFEBEE",
        _ => "#F5F5F5"
    };

    private static Color GetDifficultyChipColor(int d) => d switch
    {
        1 => Color.Success,
        2 => Color.Warning,
        3 => Color.Error,
        _ => Color.Default
    };

    // ── Demo data ─────────────────────────────────────────────────────────────
    private void LoadDemoSubjects()
    {
        _subjects =
        [
            new SubjectDto(Guid.NewGuid(), "Matematică",
                "Algebră, geometrie și analiză matematică", 1),
            new SubjectDto(Guid.NewGuid(), "Română",
                "Gramatică, literatură și comunicare", 2),
            new SubjectDto(Guid.NewGuid(), "Informatică",
                "Algoritmi, structuri de date și programare", 3),
        ];
    }

    private static List<LessonDto> GetDemoLessons(int subjectType) => subjectType switch
    {
        1 =>
        [
            new(Guid.NewGuid(), "Ecuații de gradul I",
                "Rezolvarea ecuațiilor de forma ax + b = 0. Vom învăța pașii de rezolvare și cazurile speciale.",
                1, 1, Guid.Empty, DateTime.Now.AddDays(-30)),
            new(Guid.NewGuid(), "Sisteme de ecuații",
                "Rezolvarea sistemelor de două ecuații cu două necunoscute prin metoda substituției și a reducerii.",
                2, 2, Guid.Empty, DateTime.Now.AddDays(-25)),
            new(Guid.NewGuid(), "Funcția de gradul I",
                "Proprietățile funcției liniare f(x) = ax + b. Grafic, monotonie și aplicații.",
                3, 2, Guid.Empty, DateTime.Now.AddDays(-20)),
            new(Guid.NewGuid(), "Ecuații de gradul II",
                "Formula discriminantului și rezolvarea ecuațiilor pătratice. Relațiile lui Viète.",
                4, 3, Guid.Empty, DateTime.Now.AddDays(-15)),
            new(Guid.NewGuid(), "Trigonometrie",
                "Funcțiile trigonometrice sinus, cosinus și tangentă. Identități și aplicații.",
                5, 3, Guid.Empty, DateTime.Now.AddDays(-10)),
        ],
        2 =>
        [
            new(Guid.NewGuid(), "Substantivul",
                "Definiție, clasificare și funcții sintactice ale substantivului în propoziție.",
                1, 1, Guid.Empty, DateTime.Now.AddDays(-30)),
            new(Guid.NewGuid(), "Verbul",
                "Timpurile verbale și modurile de exprimare. Conjugarea verbelor regulate și neregulate.",
                2, 1, Guid.Empty, DateTime.Now.AddDays(-25)),
            new(Guid.NewGuid(), "Propoziția subordonată",
                "Tipuri de propoziții subordonate și relațiile de subordonare în frază.",
                3, 2, Guid.Empty, DateTime.Now.AddDays(-20)),
            new(Guid.NewGuid(), "Figuri de stil",
                "Metafora, comparația, personificarea și alte figuri de stil în textele literare.",
                4, 2, Guid.Empty, DateTime.Now.AddDays(-15)),
            new(Guid.NewGuid(), "Comentariul literar",
                "Structura și tehnica redactării unui comentariu literar la nivel avansat.",
                5, 3, Guid.Empty, DateTime.Now.AddDays(-10)),
        ],
        _ =>
        [
            new(Guid.NewGuid(), "Algoritmi de bază",
                "Introducere în algoritmi: secvență, decizie și repetare. Pseudocod și flowchart.",
                1, 1, Guid.Empty, DateTime.Now.AddDays(-30)),
            new(Guid.NewGuid(), "Tablouri unidimensionale",
                "Vectori în C++: declarare, parcurgere și operații de bază. Algoritmi pe tablouri.",
                2, 1, Guid.Empty, DateTime.Now.AddDays(-25)),
            new(Guid.NewGuid(), "Sortare și căutare",
                "Algoritmii de sortare (bubble, selection, insertion) și căutarea binară.",
                3, 2, Guid.Empty, DateTime.Now.AddDays(-20)),
            new(Guid.NewGuid(), "Recursivitate",
                "Principiul recursivității. Factorial, Fibonacci și alte probleme clasice recursive.",
                4, 2, Guid.Empty, DateTime.Now.AddDays(-15)),
            new(Guid.NewGuid(), "Grafuri",
                "Reprezentarea grafurilor. BFS, DFS și aplicații în probleme de concurs.",
                5, 3, Guid.Empty, DateTime.Now.AddDays(-10)),
        ]
    };
}