@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@using AiTutor.Web.Models

@if (_isPublicPage)
{
    <!-- Layout simplu pentru Login/Register -->
    <MudThemeProvider />
    <MudSnackbarProvider />
    <MudDialogProvider />
    <div Style="background:#F5F5F5; min-height:100vh;">
        @Body
    </div>
}
else
{
    <MudLayout>
        <!-- AppBar -->
        <MudAppBar Elevation="2" Color="Color.Primary" Fixed="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-2">
                🎓 AI Tutor
            </MudText>
            <MudSpacer />
            @if (_user is not null)
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.Person"
                         Color="Color.Secondary" Size="Size.Small" Class="mr-2">
                    @_user.FullName
                </MudChip>
                <MudChip T="string" Color="Color.Warning" Size="Size.Small">
                    @GetRoleName(_user.Role)
                </MudChip>
            }
        </MudAppBar>

        <!-- Drawer lateral -->
        <MudDrawer @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Variant="DrawerVariant.Responsive"
                   Color="Color.Primary">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Class="mt-1" Style="color:white;">
                    📚 Meniu
                </MudText>
            </MudDrawerHeader>
            <NavMenu />
        </MudDrawer>

        <!-- Conținut principal -->
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 mt-16">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool      _drawerOpen  = true;
    private UserInfo? _user;
    private bool      _isPublicPage = false;

    private static readonly string[] PublicRoutes = ["/login", "/register"];

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        CheckIfPublicPage(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _user = await AuthService.GetUserAsync();
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckIfPublicPage(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void CheckIfPublicPage(string url)
    {
        _isPublicPage = PublicRoutes.Any(r =>
            url.Contains(r, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private static string GetRoleName(int role) => role switch
    {
        1 => "Elev",
        2 => "Părinte",
        3 => "Profesor",
        4 => "Admin",
        _ => "Utilizator"
    };

    public void Dispose()
        => Navigation.LocationChanged -= OnLocationChanged;
}