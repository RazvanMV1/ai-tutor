<!-- View Quiz Dialog -->
<MudDialog @bind-Visible="_showViewQuizDialog" Options="_viewQuizOptions">
    <TitleContent>
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;">
            <MudText Typo="Typo.h6" Style="font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Class="mr-2" Style="color:#1976D2;" />
                @(_viewedQuiz?.Title ?? "Quiz")
            </MudText>
            @if (!_isTeacher && _viewedQuiz != null && _quizSubmitResult == null && _viewedQuiz.Questions.Count > 0)
            {
                <div style="@($"display:flex; align-items:center; gap:6px; padding:6px 14px; border-radius:20px; font-weight:700; background:{GetTimerBg()}; color:{GetTimerFg()};")">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Style="font-size:18px;" />
                    <span style="font-family:monospace; font-size:1.1rem;">@FormatTime(_remainingSeconds)</span>
                </div>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_viewedQuiz != null)
        {
            <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
                <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(_viewedQuiz.Difficulty)">
                    @GetDifficultyName(_viewedQuiz.Difficulty)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#E3F2FD; color:#1565C0;">
                    @_viewedQuiz.TimeLimitMinutes min
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#F3E5F5; color:#6A1B9A;">
                    @_viewedQuiz.Questions.Count întrebări
                </MudChip>
            </div>

            @if (_isTeacher)
            {
                <div style="display:flex; justify-content:flex-end; margin-bottom:12px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddQuestionDialog">
                        Întrebare nouă
                    </MudButton>
                </div>

                @if (_viewedQuiz.Questions.Count == 0)
                {
                    <div style="text-align:center; padding:24px; color:#90A4AE;">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:48px;" />
                        <MudText Typo="Typo.body2" Class="mt-2">Nu există întrebări încă.</MudText>
                    </div>
                }
                else
                {
                    @foreach (var (q, idx) in _viewedQuiz.Questions.Select((q, i) => (q, i + 1)))
                    {
                        <MudPaper Class="pa-3 mb-2" Style="border-radius:8px; border:1px solid #E0E0E0;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                                <div style="flex:1;">
                                    <MudText Typo="Typo.body2" Style="font-weight:700; margin-bottom:6px;">
                                        @idx. @q.Text
                                    </MudText>
                                    <div style="display:flex; flex-direction:column; gap:4px; margin-bottom:6px;">
                                        @foreach (var opt in q.Options)
                                        {
                                            var isCorrect = opt == q.CorrectAnswer;
                                            <div style="@($"padding:4px 8px; border-radius:4px; font-size:0.85rem; {(isCorrect ? "background:#E8F5E9; color:#2E7D32; font-weight:600;" : "background:#F5F5F5; color:#546E7A;")}")">
                                                @if (isCorrect)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:14px; margin-right:4px;" />
                                                }
                                                @opt
                                            </div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(q.Explanation))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#1565C0; font-style:italic;">
                                            💡 @q.Explanation
                                        </MudText>
                                    }
                                    <MudText Typo="Typo.caption" Style="color:#90A4AE; display:block; margin-top:4px;">
                                        Punctaj: @q.Points
                                    </MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteQuestion(q.Id))" />
                            </div>
                        </MudPaper>
                    }
                }
            }
            else
            {
                @if (_viewedQuiz.Questions.Count == 0)
                {
                    <div style="text-align:center; padding:24px; color:#90A4AE;">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:48px;" />
                        <MudText Typo="Typo.body2" Class="mt-2">Acest quiz nu are încă întrebări.</MudText>
                    </div>
                }
                else if (_quizSubmitResult == null)
                {
                    @foreach (var (q, idx) in _viewedQuiz.Questions.Select((q, i) => (q, i + 1)))
                    {
                        <MudPaper Class="pa-3 mb-3" Style="border-radius:8px; border:1px solid #E0E0E0;">
                            <MudText Typo="Typo.body1" Style="font-weight:700; margin-bottom:8px;">
                                @idx. @q.Text
                            </MudText>
                            <MudRadioGroup T="string"
                                           Value="@(_studentAnswers.ContainsKey(q.Id) ? _studentAnswers[q.Id] : null)"
                                           ValueChanged="@((string val) => _studentAnswers[q.Id] = val)">
                                @foreach (var opt in q.Options)
                                {
                                    <MudRadio T="string" Value="@opt" Color="Color.Primary" Class="d-block">@opt</MudRadio>
                                }
                            </MudRadioGroup>
                            <MudText Typo="Typo.caption" Style="color:#90A4AE; display:block; margin-top:4px;">
                                Punctaj: @q.Points
                            </MudText>
                        </MudPaper>
                    }

                    <div style="display:flex; justify-content:flex-end; margin-top:16px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="@(() => SubmitStudentQuiz(false))"
                                   Disabled="_isSaving">
                            Trimite răspunsurile
                        </MudButton>
                    </div>
                }
                else
                {
                    var res = _quizSubmitResult;
                    var pct = (int)Math.Round(res.ScorePercentage);
                    var bgColor = pct >= 70 ? "#E8F5E9" : (pct >= 50 ? "#FFF3E0" : "#FCE4EC");
                    var fgColor = pct >= 70 ? "#2E7D32" : (pct >= 50 ? "#E65100" : "#C62828");

                    <MudPaper Class="pa-4 mb-3" Style="@($"border-radius:12px; background:{bgColor}; text-align:center;")">
                        <MudText Typo="Typo.h4" Style="@($"color:{fgColor}; font-weight:800;")">
                            @pct%
                        </MudText>
                        <MudText Typo="Typo.body1" Style="@($"color:{fgColor}; font-weight:600;")">
                            @res.CorrectAnswers din @res.TotalQuestions răspunsuri corecte
                        </MudText>
                        @if (_timeExpired)
                        {
                            <MudText Typo="Typo.caption" Style="color:#C62828; font-weight:700; display:block; margin-top:4px;">
                                ⏱ Timpul a expirat — răspunsurile au fost trimise automat.
                            </MudText>
                        }
                    </MudPaper>

                    @foreach (var (r, idx) in res.Results.Select((r, i) => (r, i + 1)))
                    {
                        var rBg = r.IsCorrect ? "#E8F5E9" : "#FFEBEE";
                        var rBorder = r.IsCorrect ? "#A5D6A7" : "#EF9A9A";
                        <MudPaper Class="pa-3 mb-2" Style="@($"border-radius:8px; background:{rBg}; border:1px solid {rBorder};")">
                            <div style="display:flex; align-items:flex-start; gap:8px;">
                                <MudIcon Icon="@(r.IsCorrect ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                         Style="@($"color:{(r.IsCorrect ? "#2E7D32" : "#C62828")}; font-size:24px;")" />
                                <div style="flex:1;">
                                    <MudText Typo="Typo.body2" Style="font-weight:700; margin-bottom:4px;">
                                        @idx. @r.QuestionText
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="display:block;">
                                        Răspunsul tău: <strong>@(string.IsNullOrEmpty(r.UserAnswer) ? "(fără răspuns)" : r.UserAnswer)</strong>
                                    </MudText>
                                    @if (!r.IsCorrect)
                                    {
                                        <MudText Typo="Typo.caption" Style="display:block; color:#2E7D32;">
                                            Răspuns corect: <strong>@r.CorrectAnswer</strong>
                                        </MudText>
                                    }
                                    @if (!string.IsNullOrEmpty(r.Explanation))
                                    {
                                        <MudText Typo="Typo.caption" Style="display:block; color:#1565C0; font-style:italic; margin-top:4px;">
                                            💡 @r.Explanation
                                        </MudText>
                                    }
                                </div>
                            </div>
                        </MudPaper>
                    }
                }
            }
        }
    </DialogContent>
    <DialogActions>
        @if (!_isTeacher && _quizSubmitResult != null)
        {
            <MudButton OnClick="ResetQuizAttempt" Color="Color.Primary">Mai încearcă</MudButton>
        }
        <MudButton OnClick="CloseQuizDialog">Închide</MudButton>
    </DialogActions>
</MudDialog>

