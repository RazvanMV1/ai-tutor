@page "/children/{ChildId:guid}/grades"
@inject AuthService AuthService
@inject ApiService ApiService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@using AiTutor.Web.Models

<PageTitle>Notele copilului | AiTutor</PageTitle>

<div class="page-fade-in">
    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background:linear-gradient(135deg,#FF6B35,#FF8C69); border-radius:16px;">
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Navigation.NavigateTo("/children"))"
                           Style="background:rgba(255,255,255,0.2); color:white;" />
            <MudIcon Icon="@Icons.Material.Filled.Grade" Style="color:white; font-size:32px;" />
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:800; color:white;">
                    @(_childName ?? "Notele copilului")
                </MudText>
                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.9);">
                    @(_grades.Count) note primite
                </MudText>
            </div>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_grades.Count == 0)
    {
        <MudPaper Elevation="2" Class="pa-5" Style="border-radius:16px; text-align:center;">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Style="font-size:64px; color:#BDBDBD; margin-bottom:1rem;" />
            <MudText Typo="Typo.h6" Style="font-weight:700; color:#37474F;">Nicio notă încă</MudText>
            <MudText Typo="Typo.body2" Style="color:#546E7A; margin-top:0.5rem;">
                Copilul tău nu a primit încă nicio notă de la profesori.
            </MudText>
        </MudPaper>
    }
    else
    {
        <!-- Statistici -->
        <MudGrid Class="mb-3">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px; text-align:center;">
                    <MudText Typo="Typo.caption" Style="color:#546E7A;">Media generală</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:800; color:#1976D2;">@_average.ToString("F2")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px; text-align:center;">
                    <MudText Typo="Typo.caption" Style="color:#546E7A;">Cea mai mare</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:800; color:#388E3C;">@_max</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-3" Style="border-radius:14px; text-align:center;">
                    <MudText Typo="Typo.caption" Style="color:#546E7A;">Cea mai mică</MudText>
                    <MudText Typo="Typo.h4" Style="font-weight:800; color:#D32F2F;">@_min</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Lista notelor -->
        <MudPaper Elevation="2" Class="pa-3" Style="border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:700; margin-bottom:0.75rem;">Toate notele</MudText>

            @foreach (var g in _grades)
            {
                <MudPaper Elevation="0" Class="pa-3 mb-2"
                          Style="@($"background:#F5F7FA; border-radius:12px; border-left:5px solid {GetGradeColor(g.Value)};")">
                    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                        <!-- Note value -->
                        <div style="@($"width:56px; height:56px; border-radius:14px; background:{GetGradeColor(g.Value)}; display:flex; align-items:center; justify-content:center; flex-shrink:0;")">
                            <MudText Typo="Typo.h4" Style="font-weight:900; color:white;">@g.Value</MudText>
                        </div>

                        <!-- Info -->
                        <div style="flex:1; min-width:200px;">
                            <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                                <span style="background:rgba(255,107,53,0.1); color:#FF6B35; padding:2px 10px; border-radius:10px; font-size:0.75rem; font-weight:700;">
                                    @g.SubjectName
                                </span>
                                <MudText Typo="Typo.body2" Style="font-weight:700;">@g.ClassroomName</MudText>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(g.Description))
                            {
                                <MudText Typo="Typo.body2" Style="color:#37474F; margin-top:0.25rem;">@g.Description</MudText>
                            }
                            <MudText Typo="Typo.caption" Style="color:#546E7A; margin-top:0.25rem; display:block;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Style="vertical-align:middle; font-size:14px;" />
                                @g.TeacherName · @g.GradedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            }
        </MudPaper>
    }
</div>

@code {
    [Parameter] public Guid ChildId { get; set; }

    private bool _isLoading = true;
    private List<StudentGradeDto> _grades = new();
    private string? _childName;
    private double _average = 0;
    private int _max = 0;
    private int _min = 0;

    protected override async Task OnInitializedAsync()
    {
        var role = await AuthService.GetCurrentUserRoleAsync();
        if (role != UserRole.Parent)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        var parentId = await AuthService.GetCurrentUserIdAsync();

        // Load grades + child info
        _grades = await ApiService.GetStudentGradesAsync(ChildId, parentId);

        if (_grades.Count > 0)
        {
            _average = _grades.Average(x => x.Value);
            _max = _grades.Max(x => x.Value);
            _min = _grades.Min(x => x.Value);
        }

        // Find child name from /children list
        var children = await ApiService.GetChildrenAsync(parentId);
        _childName = children.FirstOrDefault(c => c.Id == ChildId)?.FullName;

        _isLoading = false;
    }

    private string GetGradeColor(int value) => value switch
    {
        >= 9 => "#388E3C",     // verde
        >= 7 => "#1976D2",     // albastru
        >= 5 => "#F57C00",     // portocaliu
        _ => "#D32F2F"         // roșu
    };
}
