@page "/register"
@layout AiTutor.Web.Shared.MainLayout
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Înregistrare - AI Tutor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8" Style="border-radius:16px;">

        <!-- Header -->
        <div class="d-flex flex-column align-center mb-6">
            <MudText Typo="Typo.h3" Class="mb-2">📝</MudText>
            <MudText Typo="Typo.h5" Color="Color.Primary" Align="Align.Center">
                <b>Cont nou</b>
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                Completează datele pentru a te înregistra
            </MudText>
        </div>

        <MudDivider Class="mb-6" />

        <MudForm @ref="_form" @bind-IsValid="_formValid">

            <!-- Nume și Prenume -->
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_firstName"
                                  Label="Prenume"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Person"
                                  AdornmentColor="Color.Primary"
                                  Required="true"
                                  RequiredError="Prenumele este obligatoriu"
                                  FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_lastName"
                                  Label="Nume"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Numele este obligatoriu"
                                  FullWidth="true" />
                </MudItem>
            </MudGrid>

            <MudTextField @bind-Value="_email"
                          Label="Adresă email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          RequiredError="Email-ul este obligatoriu"
                          Class="mt-4"
                          FullWidth="true" />

            <MudTextField @bind-Value="_password"
                          Label="Parolă"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          RequiredError="Parola este obligatorie"
                          HelperText="Minim 8 caractere, o literă mare și un număr"
                          Class="mt-4"
                          FullWidth="true" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="Confirmă parola"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          RequiredError="Confirmarea parolei este obligatorie"
                          Validation="@((string v) => v != _password
                              ? "Parolele nu coincid" : null)"
                          Class="mt-4"
                          FullWidth="true" />

            <!-- Rol -->
            <MudSelect @bind-Value="_role"
                       Label="Rol"
                       Variant="Variant.Outlined"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Badge"
                       AdornmentColor="Color.Primary"
                       Class="mt-4"
                       FullWidth="true">
                <MudSelectItem Value="1">🎒 Elev</MudSelectItem>
                <MudSelectItem Value="2">👨‍👩‍👧 Părinte</MudSelectItem>
                <MudSelectItem Value="3">👩‍🏫 Profesor</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Disabled="@_isLoading"
                       OnClick="HandleRegister"
                       Class="mt-6"
                       Style="border-radius:8px; height:48px;">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Se înregistrează...</span>
                }
                else
                {
                    <span>Creează cont</span>
                }
            </MudButton>

        </MudForm>

        <MudDivider Class="my-4" />

        <div class="d-flex justify-center align-center">
            <MudText Typo="Typo.body2" Class="mr-1">Ai deja cont?</MudText>
            <MudLink Href="/login" Color="Color.Primary" Typo="Typo.body2">
                <b>Autentifică-te</b>
            </MudLink>
        </div>

    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private bool     _formValid       = false;
    private bool     _isLoading       = false;

    private string _firstName       = string.Empty;
    private string _lastName        = string.Empty;
    private string _email           = string.Empty;
    private string _password        = string.Empty;
    private string _confirmPassword = string.Empty;
    private int    _role            = 1;

    private bool      _showPassword      = false;
    private InputType _passwordInputType  = InputType.Password;
    private string    _passwordIcon       = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (await AuthService.IsAuthenticatedAsync())
            Navigation.NavigateTo("/dashboard");
    }

    private void TogglePasswordVisibility()
    {
        _showPassword      = !_showPassword;
        _passwordInputType = _showPassword ? InputType.Text    : InputType.Password;
        _passwordIcon      = _showPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleRegister()
    {
        await _form!.Validate();
        if (!_formValid) return;

        if (_password != _confirmPassword)
        {
            Snackbar.Add("Parolele nu coincid.", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            await ApiService.RegisterAsync(
                new RegisterRequest(_firstName, _lastName, _email, _password, _role));

            Snackbar.Add("Cont creat cu succes! Te poți autentifica acum. 🎉",
                         Severity.Success);
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 409)
        {
            Snackbar.Add("Există deja un cont cu acest email.", Severity.Warning);
        }
        catch (HttpRequestException ex) when ((int?)ex.StatusCode == 400)
        {
            Snackbar.Add("Date invalide. Verifică parola (minim 8 caractere, o literă mare, un număr).",
                         Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}