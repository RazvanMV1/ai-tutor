@page "/login"
@layout AiTutor.Web.Shared.MainLayout
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Autentificare - AI Tutor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="4" Class="pa-8" Style="border-radius:16px;">

        <!-- Header -->
        <div class="d-flex flex-column align-center mb-6">
            <MudText Typo="Typo.h3" Class="mb-2">🎓</MudText>
            <MudText Typo="Typo.h5" Color="Color.Primary" Align="Align.Center">
                <b>AI Tutor</b>
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                Platformă educațională inteligentă
            </MudText>
        </div>

        <MudDivider Class="mb-6" />

        <!-- Formular -->
        <MudForm @ref="_form" @bind-IsValid="_formValid">

            <MudTextField @bind-Value="_email"
                          Label="Adresă email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          RequiredError="Email-ul este obligatoriu"
                          Class="mb-4"
                          FullWidth="true" />

            <MudTextField @bind-Value="_password"
                          Label="Parolă"
                          Variant="Variant.Outlined"
                          InputType="@_passwordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_passwordIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentColor="Color.Primary"
                          Required="true"
                          RequiredError="Parola este obligatorie"
                          Class="mb-6"
                          FullWidth="true" />

            <!-- Buton login -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Login"
                       Disabled="@_isLoading"
                       OnClick="HandleLogin"
                       Style="border-radius:8px; height:48px;">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Se autentifică...</span>
                }
                else
                {
                    <span>Autentificare</span>
                }
            </MudButton>

        </MudForm>

        <MudDivider Class="my-4" />

        <!-- Link register -->
        <div class="d-flex justify-center align-center">
            <MudText Typo="Typo.body2" Class="mr-1">Nu ai cont?</MudText>
            <MudLink Href="/register" Color="Color.Primary" Typo="Typo.body2">
                <b>Înregistrează-te</b>
            </MudLink>
        </div>

    </MudPaper>

    <!-- Card demo credentials -->
    <MudPaper Elevation="1" Class="pa-4 mt-4" Style="border-radius:12px; background:#E3F2FD;">
        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
            Conturi demo
        </MudText>
        <MudText Typo="Typo.caption" Class="d-block">
            📧 student@test.com | 🔑 Test1234!
        </MudText>
        <MudText Typo="Typo.caption" Class="d-block">
            📧 admin@test.com &nbsp;&nbsp;| 🔑 Test1234!
        </MudText>
    </MudPaper>

</MudContainer>

@code {
    private MudForm? _form;
    private bool     _formValid  = false;
    private bool     _isLoading  = false;
    private string   _email      = string.Empty;
    private string   _password   = string.Empty;

    private bool        _showPassword     = false;
    private InputType   _passwordInputType = InputType.Password;
    private string      _passwordIcon      = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (await AuthService.IsAuthenticatedAsync())
            Navigation.NavigateTo("/dashboard");
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
        _passwordInputType = _showPassword ? InputType.Text    : InputType.Password;
        _passwordIcon      = _showPassword
            ? Icons.Material.Filled.Visibility
            : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleLogin()
    {
        await _form!.Validate();
        if (!_formValid) return;

        _isLoading = true;
        try
        {
            var response = await ApiService.LoginAsync(
                new LoginRequest(_email, _password));

            if (response is null)
            {
                Snackbar.Add("Răspuns invalid de la server.", Severity.Error);
                return;
            }

            await AuthService.SaveAuthAsync(response);
            Snackbar.Add($"Bine ai venit, {response.FirstName}! 🎉",
                         Severity.Success);
            Navigation.NavigateTo("/dashboard");
        }
        catch (HttpRequestException ex) when
            ((int?)ex.StatusCode == 401 || (int?)ex.StatusCode == 400)
        {
            Snackbar.Add("Email sau parolă incorectă.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

}