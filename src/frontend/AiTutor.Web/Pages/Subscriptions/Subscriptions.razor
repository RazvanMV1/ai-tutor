@page "/subscriptions"
@inject ApiService ApiService
@inject AuthService AuthService
@inject ISnackbar Snackbar

<PageTitle>Abonamente | AiTutor</PageTitle>

<div class="page-fade-in">
    <!-- Header -->
    <div style="background:linear-gradient(135deg,#7B1FA2,#AB47BC); border-radius:20px; padding:2rem; 
                margin-bottom:2rem; position:relative; overflow:hidden;">
        <div style="position:absolute; top:-30px; right:-30px; width:160px; height:160px; 
                    background:rgba(255,255,255,0.07); border-radius:50%;"></div>
        <div style="position:relative; z-index:1;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="color:#FFD700; font-size:36px;" />
                <MudText Typo="Typo.h4" Style="font-weight:800; color:white;">Abonamente Premium</MudText>
            </div>
            <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.85);">
                Deblochează tot potențialul platformei AiTutor
            </MudText>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-5" Style="border-radius:20px; height:420px;">
                        <MudSkeleton Width="60%" Height="28px" Class="mb-4" />
                        <MudSkeleton Width="40%" Height="44px" Class="mb-4" />
                        @for (int j = 0; j < 5; j++)
                        {
                            <MudSkeleton Width="80%" Height="16px" Class="mb-2" />
                        }
                        <MudSkeleton Width="100%" Height="48px" Class="mt-4" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (_activeSubscription != null && _activeSubscription.IsActive)
    {
        <!-- Active Subscription View -->
        <MudPaper Elevation="2" Class="pa-5 mb-4" Style="border-radius:20px; border:2px solid #388E3C;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
                <div>
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:0.75rem;">
                        <div style="width:52px; height:52px; background:rgba(56,142,60,0.1); border-radius:12px;
                                    display:flex; align-items:center; justify-content:center;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#388E3C; font-size:30px;" />
                        </div>
                        <div>
                            <div class="active-badge pulse">
                                <div class="active-dot"></div>
                                Abonament Activ
                            </div>
                            <MudText Typo="Typo.h5" Style="font-weight:800; color:#1A1A2E; margin-top:4px;">
                                @GetSubscriptionName(_activeSubscription.Type)
                            </MudText>
                        </div>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Data Start</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">
                                    @_activeSubscription.StartDate.ToString("dd MMMM yyyy")
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Data Expirare</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700; color:#388E3C;">
                                    @_activeSubscription.EndDate.ToString("dd MMMM yyyy")
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Preț Plătit</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">
                                    @_activeSubscription.Price.ToString("F2") RON
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Zile Rămase</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700; color:#1976D2;">
                                    @Math.Max(0, (int)(_activeSubscription.EndDate - DateTime.UtcNow).TotalDays) zile
                                </MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="CancelSubscription" Disabled="_isCancelling"
                           Style="border-radius:10px; font-weight:700;">
                    @if (_isCancelling)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-2" />
                    Anulează Abonamentul
                </MudButton>
            </div>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Style="border-radius:12px;">
            <MudText Typo="Typo.body2">
                Dacă anulezi abonamentul, vei pierde accesul la funcțiile premium la expirare. 
                Poți cumpăra un nou abonament oricând.
            </MudText>
        </MudAlert>
    }
    else
    {
        <!-- Plans Grid -->
        <MudText Typo="Typo.h5" Style="font-weight:700; text-align:center; margin-bottom:2rem;">
            Alege Planul Tău
        </MudText>

        <MudGrid>
            @foreach (var plan in _plans)
            {
                <MudItem xs="12" sm="6" md="4">
                    <div class="@($"plan-card flip-in stagger-{plan.Index} {(plan.IsRecommended ? "recommended" : "")}")"
                         style="@($"background:{(plan.IsRecommended ? "linear-gradient(135deg,#7B1FA2,#AB47BC)" : "white")}; " +
                                $"box-shadow:{(plan.IsRecommended ? "0 12px 40px rgba(123,31,162,0.3)" : "0 2px 12px rgba(0,0,0,0.08)")}; " +
                                $"border:{(plan.IsRecommended ? "none" : "2px solid #F0F0F0")};")">

                        @if (plan.IsRecommended)
                        {
                            <div style="position:absolute; top:-14px; left:50%; transform:translateX(-50%);">
                                <span class="popular-badge">⭐ Popular</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(plan.Badge))
                        {
                            <div style="@($"background:{(plan.IsRecommended ? "rgba(255,255,255,0.15)" : "rgba(56,142,60,0.1)")}; " +
                                        $"color:{(plan.IsRecommended ? "white" : "#388E3C")}; " +
                                        $"padding:4px 12px; border-radius:20px; font-size:0.8rem; font-weight:700; " +
                                        $"display:inline-block; margin-bottom:1rem;")">
                                @plan.Badge
                            </div>
                        }

                        <MudText Typo="Typo.h6" Style="@($"font-weight:700; color:{(plan.IsRecommended ? "rgba(255,255,255,0.85)" : "#546E7A")}; " +
                                                         $"text-transform:uppercase; letter-spacing:1px; font-size:0.85rem; margin-bottom:0.5rem;")">
                            @plan.Name
                        </MudText>

                        <div style="margin-bottom:1.5rem;">
                            <span style="@($"font-size:2.5rem; font-weight:900; color:{(plan.IsRecommended ? "white" : "#1A1A2E")};")">
                                @plan.Price.ToString("F0")
                            </span>
                            <span style="@($"color:{(plan.IsRecommended ? "rgba(255,255,255,0.7)" : "#546E7A")}; font-size:0.9rem;")">
                                RON/@plan.Period
                            </span>
                        </div>

                        <MudDivider Style="@($"border-color:{(plan.IsRecommended ? "rgba(255,255,255,0.2)" : "#F0F0F0")}; margin-bottom:1rem;")" />

                        @foreach (var feature in plan.Features)
                        {
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Style="@($"color:{(plan.IsRecommended ? "#FFD700" : "#388E3C")}; font-size:18px; flex-shrink:0;")" />
                                <MudText Typo="Typo.body2" Style="@($"color:{(plan.IsRecommended ? "rgba(255,255,255,0.9)" : "#37474F")};")">
                                    @feature
                                </MudText>
                            </div>
                        }

                        <div style="margin-top:1.5rem;">
                            <MudButton Variant="Variant.Filled" FullWidth="true"
                                       OnClick="@(() => PurchasePlan(plan))"
                                       Disabled="_isPurchasing"
                                       Class="btn-bounce"
                                       Style="@($"border-radius:12px; height:48px; font-weight:700; font-size:0.95rem; " +
                                              $"background:{(plan.IsRecommended ? "white" : "linear-gradient(135deg,#7B1FA2,#AB47BC)")}; " +
                                              $"color:{(plan.IsRecommended ? "#7B1FA2" : "white")};")">
                                @if (_isPurchasing && _purchasingPlan == plan.Type)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"
                                                         Color="@(plan.IsRecommended ? Color.Secondary : Color.Inherit)" />
                                }
                                Cumpără Acum
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>

        <div style="text-align:center; margin-top:2rem; color:#546E7A;">
            <MudIcon Icon="@Icons.Material.Filled.Security" Style="vertical-align:middle; margin-right:6px; color:#388E3C;" />
            <MudText Typo="Typo.body2" Style="display:inline;">
                Plată securizată · Poți anula oricând · Suport 24/7
            </MudText>
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isPurchasing = false;
    private bool _isCancelling = false;
    private SubscriptionType _purchasingPlan;
    private SubscriptionDto? _activeSubscription;

    private List<PlanInfo> _plans = new()
    {
        new(1, "Lunar", 29.99m, "lună", SubscriptionType.ParentMonthly, false, "", new()
        {
            "Explicații AI nelimitate",
            "Acces la toate quiz-urile",
            "Urmărire progres",
            "Lecții complete",
            "Suport email"
        }),
        new(2, "Anual", 249.99m, "an", SubscriptionType.ParentYearly, true, "🎉 Economisești 110 RON", new()
        {
            "Tot ce include Lunar",
            "Economii de 30%",
            "Statistici avansate",
            "Export rapoarte",
            "Suport prioritar"
        }),
        new(3, "Școală", 999.99m, "an", SubscriptionType.School, false, "Licență multi-utilizator", new()
        {
            "Licență pentru 30 elevi",
            "Panou administrator",
            "Rapoarte detaliate",
            "Integrare Google Workspace",
            "Suport dedicat"
        }),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            _activeSubscription = await ApiService.GetSubscriptionByUserAsync(userId);
        }
        catch { }
        _isLoading = false;
    }

    private async Task PurchasePlan(PlanInfo plan)
    {
        _isPurchasing = true;
        _purchasingPlan = plan.Type;
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            var startDate = DateTime.UtcNow;
            var endDate = plan.Type == SubscriptionType.ParentMonthly
                ? startDate.AddMonths(1)
                : startDate.AddYears(1);

            var result = await ApiService.CreateSubscriptionAsync(new CreateSubscriptionRequest
            {
                UserId = userId,
                Type = plan.Type,
                Price = plan.Price,
                StartDate = startDate,
                EndDate = endDate
            });

            if (result != null)
            {
                _activeSubscription = result;
                Snackbar.Add("Abonament activat cu succes! 🎉", Severity.Success);
            }
            else
            {
                Snackbar.Add("Eroare la activarea abonamentului.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare la procesarea plății.", Severity.Error);
        }
        _isPurchasing = false;
    }

    private async Task CancelSubscription()
    {
        if (_activeSubscription == null) return;
        _isCancelling = true;
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            var success = await ApiService.CancelSubscriptionAsync(_activeSubscription.Id, userId);
            if (success)
            {
                _activeSubscription = null;
                Snackbar.Add("Abonamentul a fost anulat.", Severity.Info);
            }
            else
            {
                Snackbar.Add("Eroare la anularea abonamentului.", Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add("Eroare la anularea abonamentului.", Severity.Error);
        }
        _isCancelling = false;
    }

    private string GetSubscriptionName(SubscriptionType type) => type switch
    {
        SubscriptionType.ParentMonthly => "Plan Lunar",
        SubscriptionType.ParentYearly => "Plan Anual",
        SubscriptionType.School => "Plan Școală",
        _ => "Plan Gratuit"
    };

    private record PlanInfo(int Index, string Name, decimal Price, string Period,
        SubscriptionType Type, bool IsRecommended, string Badge, List<string> Features);
}
