@page "/classrooms/{ClassroomId:guid}"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Detalii ClasÄƒ | AiTutor</PageTitle>

@if (_isLoading)
{
    <div style="padding:24px;">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Style="border-radius:16px; margin-bottom:24px;" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius:8px; margin-bottom:16px;" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Style="border-radius:16px;" />
    </div>
}
else if (_classroom == null)
{
    <div style="padding:24px; text-align:center;">
        <MudText Typo="Typo.h6" Style="color:#546E7A;">Clasa nu a fost gÄƒsitÄƒ.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='() => Navigation.NavigateTo("/classrooms")' Class="mt-4">
            ÃŽnapoi la Clase
        </MudButton>
    </div>
}
else
{
    <div class="page-fade-in" style="padding:24px; max-width:1200px; margin:0 auto;">

        <!-- Header -->
        <div style="background:linear-gradient(135deg,#1976D2,#42A5F5); border-radius:16px; padding:24px; margin-bottom:24px; color:white;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                <div>
                    <MudButton Variant="Variant.Text" Style="color:rgba(255,255,255,0.8); margin-bottom:8px; padding:0;"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick='() => Navigation.NavigateTo("/classrooms")'>
                        ÃŽnapoi
                    </MudButton>
                    <MudText Typo="Typo.h4" Style="font-weight:700; color:white;">@_classroom.Name</MudText>
                    @if (!string.IsNullOrEmpty(_classroom.Description))
                    {
                        <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.85); margin-top:4px;">@_classroom.Description</MudText>
                    }
                    <div style="display:flex; gap:16px; margin-top:12px; flex-wrap:wrap;">
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size:16px; margin-right:4px;" />
                            @_classroom.MemberCount / @_classroom.MaxStudents elevi
                        </MudChip>
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:16px; margin-right:4px;" />
                            @_classroom.LessonCount lecÈ›ii
                        </MudChip>
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            @GetSubjectName(_classroom.SubjectType)
                        </MudChip>
                    </div>
                </div>
                @if (_isTeacher)
                {
                    <div style="background:rgba(255,255,255,0.15); border-radius:12px; padding:12px 20px; text-align:center;">
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7); display:block;">Cod ClasÄƒ</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800; letter-spacing:4px; color:white;">@_classroom.ClassCode</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:rgba(255,255,255,0.8);"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyCode">
                            CopiazÄƒ
                        </MudButton>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
                 Style="background:white; border-radius:16px; padding:8px;">
            <!-- LecÈ›ii -->
            <MudTabPanel Text="LecÈ›ii" Icon="@Icons.Material.Filled.MenuBook">
                <div style="padding:16px;">
                    @if (_isTeacher)
                    {
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateLessonDialog"
                                       Style="border-radius:12px;">
                                LecÈ›ie NouÄƒ
                            </MudButton>
                        </div>
                    }
                    @if (_lessons.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu existÄƒ lecÈ›ii Ã®n aceastÄƒ clasÄƒ.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudList T="ClassroomLessonDto">
                            @foreach (var lesson in _lessons.OrderBy(l => l.OrderIndex))
                            {
                                <MudListItem T="ClassroomLessonDto">
                                    <MudPaper Class="pa-3 mb-2" Style="border-radius:12px; border:1px solid #E0E0E0;">
                                    <div style="cursor:pointer;" @onclick="() => OpenViewLessonDialog(lesson)">
                                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                            <div style="flex:1; min-width:0;">
                                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                                    <MudText Typo="Typo.body1" Style="font-weight:600;">@lesson.Title</MudText>
                                                    <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(lesson.Difficulty)">
                                                        @GetDifficultyName(lesson.Difficulty)
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.caption" Style="color:#90A4AE;">
                                                    LecÈ›ia @lesson.OrderIndex
                                                </MudText>
                                            </div>
                                            @if (_isTeacher)
                                            {
                                                <div style="display:flex; gap:4px; align-items:center;" @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                Color="Color.Primary" Size="Size.Small"
                                                                OnClick="@(() => OpenEditLessonDialog(lesson))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                Color="Color.Error" Size="Size.Small"
                                                                OnClick="@(() => DeleteLesson(lesson.Id))" />
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                            Color="Color.Primary"
                                                            OnClick="@(() => OpenCreateQuizDialog(lesson.Id))">
                                                        + Quiz
                                                    </MudButton>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* Lista quiz-urilor pentru lecÈ›ia asta *@
                                    @if (_quizzesByLesson.ContainsKey(lesson.Id) && _quizzesByLesson[lesson.Id].Count > 0)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600; margin-bottom:6px; display:block;">
                                            Quiz-uri:
                                        </MudText>
                                        @foreach (var quiz in _quizzesByLesson[lesson.Id])
                                        {
                                            <div style="display:flex; align-items:center; gap:8px; padding:6px 8px; background:#F5F7FA; border-radius:6px; margin-bottom:4px; cursor:pointer;"
                                                @onclick="() => OpenViewQuizDialog(quiz.Id)">
                                                <MudIcon Icon="@Icons.Material.Filled.Quiz" Style="color:#1976D2; font-size:18px;" />
                                                <div style="flex:1;">
                                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@quiz.Title</MudText>
                                                    <MudText Typo="Typo.caption" Style="color:#90A4AE;">
                                                        @quiz.QuestionCount Ã®ntrebÄƒri Â· @quiz.TimeLimitMinutes min
                                                    </MudText>
                                                </div>
                                                @if (_isTeacher)
                                                {
                                                    <div style="display:flex; gap:2px;" @onclick:stopPropagation="true">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                    Color="Color.Primary" Size="Size.Small"
                                                                    OnClick="@(() => OpenEditQuizDialog(quiz))" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                    Color="Color.Error" Size="Size.Small"
                                                                    OnClick="@(() => DeleteQuiz(quiz.Id))" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </MudPaper>

                                </MudListItem>
                            }
                        </MudList>
                    }
                </div>
            </MudTabPanel>

            <!-- Elevi -->
            <MudTabPanel Text="Elevi" Icon="@Icons.Material.Filled.People">
                <div style="padding:16px;">
                    @if (_isTeacher)
                    {
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddMemberDialog"
                                       Style="border-radius:12px;">
                                AdaugÄƒ Elev
                            </MudButton>
                        </div>
                    }
                    @if (_members.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu existÄƒ elevi Ã®nscriÈ™i.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_members" Hover="true" Striped="true" Style="border-radius:12px;">
                            <HeaderContent>
                                <MudTh>Nume</MudTh>
                                <MudTh>Email</MudTh>
                                <MudTh>Data Ã®nscrierii</MudTh>
                                @if (_isTeacher)
                                {
                                    <MudTh>AcÈ›iuni</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <MudAvatar Style="background:#1976D2; color:white; width:32px; height:32px; font-size:14px;">
                                            @context.FullName.FirstOrDefault()
                                        </MudAvatar>
                                        @context.FullName
                                    </div>
                                </MudTd>
                                <MudTd>@context.Email</MudTd>
                                <MudTd>@context.JoinedAt.ToString("dd MMM yyyy")</MudTd>
                                @if (_isTeacher)
                                {
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => RemoveMember(context.StudentId)" />
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- Catalog -->
            @if (_isTeacher)
            {
                <MudTabPanel Text="Catalog" Icon="@Icons.Material.Filled.Grade">
                    <div style="padding:16px;">
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddGradeDialog"
                                       Style="border-radius:12px;">
                                AdaugÄƒ NotÄƒ
                            </MudButton>
                        </div>
                        @if (_grades.Count == 0)
                        {
                            <div style="text-align:center; padding:32px;">
                                <MudIcon Icon="@Icons.Material.Filled.Grade" Style="font-size:48px; color:#B0BEC5;" />
                                <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu existÄƒ note Ã®n catalog.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudTable Items="_grades" Hover="true" Striped="true" Style="border-radius:12px;">
                                <HeaderContent>
                                    <MudTh>Elev</MudTh>
                                    <MudTh>NotÄƒ</MudTh>
                                    <MudTh>Descriere</MudTh>
                                    <MudTh>Data</MudTh>
                                    <MudTh>AcÈ›iuni</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.StudentName</MudTd>
                                    <MudTd>
                                        <MudChip T="string" Style="@GetGradeStyle(context.Value)" Size="Size.Small">
                                            @context.Value
                                        </MudChip>
                                    </MudTd>
                                    <MudTd>@(context.Description ?? "-")</MudTd>
                                    <MudTd>@context.GradedAt.ToString("dd MMM yyyy")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => DeleteGrade(context.Id)" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>
                </MudTabPanel>
            }

            <!-- Progres -->
            <MudTabPanel Text="Progres" Icon="@Icons.Material.Filled.TrendingUp">
                <div style="padding:16px;">
                    @if (_progress.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu existÄƒ date de progres.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_progress" Hover="true" Striped="true" Style="border-radius:12px;">
                            <HeaderContent>
                                @if (_isTeacher)
                                {
                                    <MudTh>Elev</MudTh>
                                }
                                <MudTh>LecÈ›ie</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Scor</MudTh>
                                <MudTh>ÃŽncercÄƒri</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @if (_isTeacher)
                                {
                                    <MudTd>@context.StudentName</MudTd>
                                }
                                <MudTd>@context.LessonTitle</MudTd>
                                <MudTd>
                                    @if (context.IsCompleted)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background:#E8F5E9; color:#2E7D32;">Completat</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background:#FFF3E0; color:#E65100;">ÃŽn progres</MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <MudProgressLinear Value="@context.ScorePercentage" Style="width:80px;" Color="Color.Primary" />
                                        <MudText Typo="Typo.caption">@context.ScorePercentage%</MudText>
                                    </div>
                                </MudTd>
                                <MudTd>@context.AttemptsCount</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
}

<!-- Create Lesson Dialog -->
<MudDialog @bind-Visible="_showCreateLessonDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">LecÈ›ie NouÄƒ</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newLesson.Title" Label="Titlu lecÈ›ie" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_newLesson.Content" Label="ConÈ›inut"
                      Variant="Variant.Outlined" Lines="5" Class="mb-3" />
        <MudNumericField @bind-Value="_newLesson.OrderIndex" Label="Ordinea lecÈ›iei"
                         Min="1" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_newLesson.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined">
            <MudSelectItem Value="DifficultyLevel.Beginner">ÃŽncepÄƒtor</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateLessonDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="CreateLesson" Disabled="_isSaving">
            CreeazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- View Lesson Dialog -->
<MudDialog @bind-Visible="_showViewLessonDialog" Options="_viewLessonOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2" Style="color:#1976D2;" />
            @(_viewedLesson?.Title ?? "LecÈ›ie")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewedLesson != null)
        {
            <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
                <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(_viewedLesson.Difficulty)">
                    @GetDifficultyName(_viewedLesson.Difficulty)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#E3F2FD; color:#1565C0;">
                    LecÈ›ia @_viewedLesson.OrderIndex
                </MudChip>
            </div>
            <MudText Typo="Typo.subtitle2" Style="color:#546E7A; margin-bottom:8px;">ConÈ›inut:</MudText>
            <MudPaper Class="pa-3" Style="background:#F5F7FA; border-radius:8px; max-height:400px; overflow-y:auto;">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">
                    @(string.IsNullOrWhiteSpace(_viewedLesson.Content) ? "(fÄƒrÄƒ conÈ›inut)" : _viewedLesson.Content)
                </MudText>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showViewLessonDialog = false">ÃŽnchide</MudButton>
        @if (_isTeacher && _viewedLesson != null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => { _showViewLessonDialog = false; OpenEditLessonDialog(_viewedLesson); })">
                EditeazÄƒ
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- Edit Lesson Dialog -->
<MudDialog @bind-Visible="_showEditLessonDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">EditeazÄƒ LecÈ›ie</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editLesson.Title" Label="Titlu lecÈ›ie" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_editLesson.Content" Label="ConÈ›inut"
                      Variant="Variant.Outlined" Lines="6" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_editLesson.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined">
            <MudSelectItem Value="DifficultyLevel.Beginner">ÃŽncepÄƒtor</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEditLessonDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="UpdateLesson" Disabled="_isSaving">
            SalveazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Add Member Dialog -->
<MudDialog @bind-Visible="_showAddMemberDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">AdaugÄƒ Elev</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_memberEmail" Label="Email elev" Required="true"
                      Placeholder="elev@email.com" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showAddMemberDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="AddMember" Disabled="_isSaving">
            AdaugÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Add Grade Dialog -->
<MudDialog @bind-Visible="_showAddGradeDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">AdaugÄƒ NotÄƒ</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="Guid" @bind-Value="_newGrade.StudentId"
                   Label="Elev" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var member in _members)
            {
                <MudSelectItem Value="member.StudentId">@member.FullName</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField @bind-Value="_newGrade.Value" Label="NotÄƒ (1-10)"
                         Min="1" Max="10" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_newGrade.Description" Label="Descriere (opÈ›ional)"
                      Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showAddGradeDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="AddGrade" Disabled="_isSaving">
            SalveazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Create Quiz Dialog -->
<MudDialog @bind-Visible="_showCreateQuizDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Quiz Nou</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newQuiz.Title" Label="Titlu quiz" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_newQuiz.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="DifficultyLevel.Beginner">ÃŽncepÄƒtor</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
        <MudNumericField @bind-Value="_newQuiz.TimeLimitMinutes" Label="LimitÄƒ timp (minute)"
                         Min="5" Max="180" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateQuizDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="CreateQuiz" Disabled="_isSaving">
            CreeazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- View Quiz Dialog -->
<MudDialog @bind-Visible="_showViewQuizDialog" Options="_viewQuizOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">
            <MudIcon Icon="@Icons.Material.Filled.Quiz" Class="mr-2" Style="color:#1976D2;" />
            @(_viewedQuiz?.Title ?? "Quiz")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewedQuiz != null)
        {
            <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
                <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(_viewedQuiz.Difficulty)">
                    @GetDifficultyName(_viewedQuiz.Difficulty)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#E3F2FD; color:#1565C0;">
                    @_viewedQuiz.TimeLimitMinutes min
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#F3E5F5; color:#6A1B9A;">
                    @_viewedQuiz.Questions.Count Ã®ntrebÄƒri
                </MudChip>
            </div>

            @if (_isTeacher)
            {
                <div style="display:flex; justify-content:flex-end; margin-bottom:12px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddQuestionDialog">
                        ÃŽntrebare nouÄƒ
                    </MudButton>
                </div>
            }

            @if (_viewedQuiz.Questions.Count == 0)
            {
                <div style="text-align:center; padding:24px; color:#90A4AE;">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:48px;" />
                    <MudText Typo="Typo.body2" Class="mt-2">Nu existÄƒ Ã®ntrebÄƒri Ã®ncÄƒ.</MudText>
                </div>
            }
            else
            {
                @foreach (var (q, idx) in _viewedQuiz.Questions.Select((q, i) => (q, i + 1)))
                {
                    <MudPaper Class="pa-3 mb-2" Style="border-radius:8px; border:1px solid #E0E0E0;">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                            <div style="flex:1;">
                                <MudText Typo="Typo.body2" Style="font-weight:700; margin-bottom:6px;">
                                    @idx. @q.Text
                                </MudText>
                                <div style="display:flex; flex-direction:column; gap:4px; margin-bottom:6px;">
                                    @foreach (var opt in q.Options)
                                    {
                                        var isCorrect = opt == q.CorrectAnswer;
                                        <div style="@($"padding:4px 8px; border-radius:4px; font-size:0.85rem; {(isCorrect ? "background:#E8F5E9; color:#2E7D32; font-weight:600;" : "background:#F5F5F5; color:#546E7A;")}")">
                                            @if (isCorrect)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size:14px; margin-right:4px;" />
                                            }
                                            @opt
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(q.Explanation))
                                {
                                    <MudText Typo="Typo.caption" Style="color:#1565C0; font-style:italic;">
                                        ðŸ’¡ @q.Explanation
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Style="color:#90A4AE; display:block; margin-top:4px;">
                                    Punctaj: @q.Points
                                </MudText>
                            </div>
                            @if (_isTeacher)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteQuestion(q.Id))" />
                            }
                        </div>
                    </MudPaper>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showViewQuizDialog = false">ÃŽnchide</MudButton>
    </DialogActions>
</MudDialog>

<!-- Edit Quiz Dialog -->
<MudDialog @bind-Visible="_showEditQuizDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">EditeazÄƒ Quiz</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editQuiz.Title" Label="Titlu quiz" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_editQuiz.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="DifficultyLevel.Beginner">ÃŽncepÄƒtor</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
        <MudNumericField @bind-Value="_editQuiz.TimeLimitMinutes" Label="LimitÄƒ timp (minute)"
                         Min="5" Max="180" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEditQuizDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="UpdateQuiz" Disabled="_isSaving">
            SalveazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Add Question Dialog -->
<MudDialog @bind-Visible="_showAddQuestionDialog" Options="_viewQuizOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">ÃŽntrebare NouÄƒ</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newQuestion.Text" Label="Text Ã®ntrebare" Required="true"
                      Variant="Variant.Outlined" Lines="2" Class="mb-3" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Variante de rÄƒspuns:</MudText>
        @for (int i = 0; i < _newQuestionOptions.Count; i++)
        {
            var idx = i;
            <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px;">
                <MudTextField @bind-Value="_newQuestionOptions[idx]" Label="@($"Varianta {idx + 1}")"
                              Variant="Variant.Outlined" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => RemoveOption(idx))"
                               Disabled="@(_newQuestionOptions.Count <= 2)" />
            </div>
        }
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddOption" Class="mb-3"
                   Disabled="@(_newQuestionOptions.Count >= 6)">
            AdaugÄƒ variantÄƒ
        </MudButton>

        <MudSelect T="string" @bind-Value="_newQuestion.CorrectAnswer"
                   Label="RÄƒspuns corect *" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var opt in _newQuestionOptions.Where(o => !string.IsNullOrWhiteSpace(o)))
            {
                <MudSelectItem Value="opt">@opt</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField @bind-Value="_newQuestion.Points" Label="Punctaj" Min="1" Max="100"
                         Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_newQuestion.Explanation" Label="ExplicaÈ›ie (opÈ›ional)"
                      Variant="Variant.Outlined" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showAddQuestionDialog = false">AnuleazÄƒ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="AddQuestion" Disabled="_isSaving">
            SalveazÄƒ
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    [Parameter] public Guid ClassroomId { get; set; }

    private ClassroomDto? _classroom;
    private List<ClassroomLessonDto> _lessons = new();
    private List<ClassroomMemberDto> _members = new();
    private List<GradeDto> _grades = new();
    private List<ClassroomProgressDto> _progress = new();
    private bool _isLoading = true;
    private bool _isTeacher = false;
    private bool _isSaving = false;
    private Guid _userId;

    private bool _showCreateLessonDialog = false;
    private bool _showAddMemberDialog = false;
    private bool _showAddGradeDialog = false;
    private bool _showCreateQuizDialog = false;
    private bool _showViewLessonDialog = false;
    private bool _showEditLessonDialog = false;
    private Guid _selectedLessonId;
    private Guid _editingLessonId;
    private ClassroomLessonDto? _viewedLesson;

    private CreateClassroomLessonRequest _newLesson = new();
    private CreateClassroomQuizRequest _newQuiz = new();
    private AddGradeRequest _newGrade = new();
    private UpdateClassroomLessonRequest _editLesson = new();
    private string _memberEmail = string.Empty;

    private bool _showViewQuizDialog = false;
    private bool _showEditQuizDialog = false;
    private bool _showAddQuestionDialog = false;
    private ClassroomQuizDetailDto? _viewedQuiz;
    private Guid _editingQuizId;
    private UpdateClassroomQuizRequest _editQuiz = new();
    private AddClassroomQuestionRequest _newQuestion = new();
    private List<string> _newQuestionOptions = new() { "", "" };
    private Dictionary<Guid, List<ClassroomQuizDto>> _quizzesByLesson = new();

    private DialogOptions _viewLessonOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    private DialogOptions _viewQuizOptions = new()
{
    MaxWidth = MaxWidth.Medium,
    FullWidth = true,
    CloseButton = true
};

    protected override async Task OnInitializedAsync()
    {
        var userId = await AuthService.GetCurrentUserIdAsync();
        var role = await AuthService.GetCurrentUserRoleAsync();
        if (userId == Guid.Empty)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        _userId = userId;
        _isTeacher = role == UserRole.Teacher || role == UserRole.Admin;
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _classroom = await ApiService.GetClassroomByIdAsync(ClassroomId, _userId);
        if (_classroom != null)
        {
            var tasks = new List<Task>
            {
                LoadLessons(),
                LoadProgress()
            };
            if (_isTeacher)
            {
                tasks.Add(LoadMembers());
                tasks.Add(LoadGrades());
            }
            await Task.WhenAll(tasks);
        }
        _isLoading = false;
    }

    private async Task LoadLessons()
    {
        _lessons = await ApiService.GetClassroomLessonsAsync(ClassroomId, _userId);
        _quizzesByLesson.Clear();
        foreach (var l in _lessons)
        {
            var quizzes = await ApiService.GetClassroomQuizzesByLessonAsync(ClassroomId, l.Id, _userId);
            _quizzesByLesson[l.Id] = quizzes;
        }
    }


    private async Task LoadMembers() =>
        _members = await ApiService.GetClassroomMembersAsync(ClassroomId, _userId);

    private async Task LoadGrades() =>
        _grades = await ApiService.GetClassroomGradesAsync(ClassroomId, _userId, _isTeacher);

    private async Task LoadProgress() =>
        _progress = await ApiService.GetClassroomProgressAsync(ClassroomId, _userId);

    private void OpenCreateLessonDialog()
    {
        _newLesson = new CreateClassroomLessonRequest();
        _showCreateLessonDialog = true;
    }

    private void OpenAddMemberDialog()
    {
        _memberEmail = string.Empty;
        _showAddMemberDialog = true;
    }

    private void OpenAddGradeDialog()
    {
        _newGrade = new AddGradeRequest { Value = 5 };
        _showAddGradeDialog = true;
    }

    private void OpenCreateQuizDialog(Guid lessonId)
    {
        _selectedLessonId = lessonId;
        _newQuiz = new CreateClassroomQuizRequest();
        _showCreateQuizDialog = true;
    }

    private void OpenViewLessonDialog(ClassroomLessonDto lesson)
    {
        _viewedLesson = lesson;
        _showViewLessonDialog = true;
    }

    private async Task OpenViewQuizDialog(Guid quizId)
{
    var quiz = await ApiService.GetClassroomQuizByIdAsync(ClassroomId, quizId, _userId);
    if (quiz != null)
    {
        _viewedQuiz = quiz;
        _showViewQuizDialog = true;
    }
    else
    {
        Snackbar.Add("Eroare la Ã®ncÄƒrcarea quiz-ului.", Severity.Error);
    }
}

private void OpenEditQuizDialog(ClassroomQuizDto quiz)
{
    _editingQuizId = quiz.Id;
    _editQuiz = new UpdateClassroomQuizRequest
    {
        Title = quiz.Title,
        Difficulty = quiz.Difficulty,
        TimeLimitMinutes = quiz.TimeLimitMinutes
    };
    _showEditQuizDialog = true;
}

private async Task UpdateQuiz()
{
    if (string.IsNullOrWhiteSpace(_editQuiz.Title)) return;
    _isSaving = true;
    var result = await ApiService.UpdateClassroomQuizAsync(
        ClassroomId, _editingQuizId, _userId, _editQuiz);
    _isSaving = false;
    if (result != null)
    {
        _showEditQuizDialog = false;
        Snackbar.Add("Quiz-ul a fost actualizat!", Severity.Success);
        await LoadLessons();
    }
    else
    {
        Snackbar.Add("Eroare la actualizarea quiz-ului.", Severity.Error);
    }
}

private async Task DeleteQuiz(Guid quizId)
{
    var result = await ApiService.DeleteClassroomQuizAsync(ClassroomId, quizId, _userId);
    if (result)
    {
        Snackbar.Add("Quiz-ul a fost È™ters.", Severity.Info);
        await LoadLessons();
    }
    else
    {
        Snackbar.Add("Eroare la È™tergerea quiz-ului.", Severity.Error);
    }
}

private void OpenAddQuestionDialog()
{
    _newQuestion = new AddClassroomQuestionRequest { Points = 10 };
    _newQuestionOptions = new List<string> { "", "" };
    _showAddQuestionDialog = true;
}

private void AddOption()
{
    if (_newQuestionOptions.Count < 6) _newQuestionOptions.Add("");
}

private void RemoveOption(int idx)
{
    if (_newQuestionOptions.Count > 2) _newQuestionOptions.RemoveAt(idx);
}

private async Task AddQuestion()
{
    if (_viewedQuiz == null) return;
    if (string.IsNullOrWhiteSpace(_newQuestion.Text))
    {
        Snackbar.Add("Textul Ã®ntrebÄƒrii este obligatoriu.", Severity.Warning);
        return;
    }
    var validOptions = _newQuestionOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
    if (validOptions.Count < 2)
    {
        Snackbar.Add("Trebuie cel puÈ›in 2 variante de rÄƒspuns.", Severity.Warning);
        return;
    }
    if (string.IsNullOrWhiteSpace(_newQuestion.CorrectAnswer) ||
        !validOptions.Contains(_newQuestion.CorrectAnswer))
    {
        Snackbar.Add("Trebuie sÄƒ alegi un rÄƒspuns corect dintre variante.", Severity.Warning);
        return;
    }

    _newQuestion.Options = validOptions;
    _isSaving = true;
    var result = await ApiService.AddClassroomQuestionAsync(
        ClassroomId, _viewedQuiz.Id, _userId, _newQuestion);
    _isSaving = false;

    if (result != null)
    {
        Snackbar.Add("ÃŽntrebarea a fost adÄƒugatÄƒ!", Severity.Success);
        _showAddQuestionDialog = false;
        // ReÃ®ncarcÄƒ quiz-ul ca sÄƒ se vadÄƒ noua Ã®ntrebare
        var refreshed = await ApiService.GetClassroomQuizByIdAsync(ClassroomId, _viewedQuiz.Id, _userId);
        if (refreshed != null) _viewedQuiz = refreshed;
        await LoadLessons();
    }
    else
    {
        Snackbar.Add("Eroare la adÄƒugarea Ã®ntrebÄƒrii.", Severity.Error);
    }
}

private async Task DeleteQuestion(Guid questionId)
{
    if (_viewedQuiz == null) return;
    var result = await ApiService.DeleteClassroomQuestionAsync(
        ClassroomId, _viewedQuiz.Id, questionId, _userId);
    if (result)
    {
        Snackbar.Add("ÃŽntrebarea a fost È™tearsÄƒ.", Severity.Info);
        var refreshed = await ApiService.GetClassroomQuizByIdAsync(ClassroomId, _viewedQuiz.Id, _userId);
        if (refreshed != null) _viewedQuiz = refreshed;
        await LoadLessons();
    }
    else
    {
        Snackbar.Add("Eroare la È™tergerea Ã®ntrebÄƒrii.", Severity.Error);
    }
}

    private void OpenEditLessonDialog(ClassroomLessonDto lesson)
    {
        _editingLessonId = lesson.Id;
        _editLesson = new UpdateClassroomLessonRequest
        {
            Title = lesson.Title,
            Content = lesson.Content,
            Difficulty = lesson.Difficulty
        };
        _showEditLessonDialog = true;
    }

    

    private async Task CreateLesson()
    {
        if (string.IsNullOrWhiteSpace(_newLesson.Title)) return;
        _isSaving = true;
        var result = await ApiService.CreateClassroomLessonAsync(ClassroomId, _userId, _newLesson);
        _isSaving = false;
        if (result != null)
        {
            _showCreateLessonDialog = false;
            Snackbar.Add("LecÈ›ia a fost creatÄƒ!", Severity.Success);
            await LoadLessons();
        }
        else
        {
            Snackbar.Add("Eroare la crearea lecÈ›iei.", Severity.Error);
        }
    }

    private async Task UpdateLesson()
    {
        if (string.IsNullOrWhiteSpace(_editLesson.Title)) return;
        _isSaving = true;
        var result = await ApiService.UpdateClassroomLessonAsync(
            ClassroomId, _editingLessonId, _userId, _editLesson);
        _isSaving = false;
        if (result != null)
        {
            _showEditLessonDialog = false;
            Snackbar.Add("LecÈ›ia a fost actualizatÄƒ!", Severity.Success);
            await LoadLessons();
        }
        else
        {
            Snackbar.Add("Eroare la actualizarea lecÈ›iei.", Severity.Error);
        }
    }

    private async Task DeleteLesson(Guid lessonId)
    {
        var result = await ApiService.DeleteClassroomLessonAsync(ClassroomId, lessonId, _userId);
        if (result)
        {
            Snackbar.Add("LecÈ›ia a fost È™tearsÄƒ.", Severity.Info);
            await LoadLessons();
        }
        else
        {
            Snackbar.Add("Eroare la È™tergerea lecÈ›iei.", Severity.Error);
        }
    }

    private async Task AddMember()
    {
        if (string.IsNullOrWhiteSpace(_memberEmail)) return;
        _isSaving = true;
        var result = await ApiService.AddMemberAsync(ClassroomId, _userId, _memberEmail);
        _isSaving = false;
        if (result)
        {
            _showAddMemberDialog = false;
            Snackbar.Add("Elevul a fost adÄƒugat!", Severity.Success);
            await LoadMembers();
        }
        else
        {
            Snackbar.Add("Eroare. VerificÄƒ emailul elevului.", Severity.Error);
        }
    }

    private async Task RemoveMember(Guid studentId)
    {
        var result = await ApiService.RemoveMemberAsync(ClassroomId, studentId, _userId);
        if (result)
        {
            Snackbar.Add("Elevul a fost eliminat.", Severity.Info);
            await LoadMembers();
        }
        else
        {
            Snackbar.Add("Eroare la eliminarea elevului.", Severity.Error);
        }
    }

    private async Task AddGrade()
    {
        if (_newGrade.StudentId == Guid.Empty) return;
        _isSaving = true;
        var result = await ApiService.AddGradeAsync(ClassroomId, _userId, _newGrade);
        _isSaving = false;
        if (result != null)
        {
            _showAddGradeDialog = false;
            Snackbar.Add("Nota a fost adÄƒugatÄƒ!", Severity.Success);
            await LoadGrades();
        }
        else
        {
            Snackbar.Add("Eroare la adÄƒugarea notei.", Severity.Error);
        }
    }

    private async Task DeleteGrade(Guid gradeId)
    {
        var result = await ApiService.DeleteGradeAsync(ClassroomId, gradeId, _userId);
        if (result)
        {
            Snackbar.Add("Nota a fost È™tearsÄƒ.", Severity.Info);
            await LoadGrades();
        }
        else
        {
            Snackbar.Add("Eroare la È™tergerea notei.", Severity.Error);
        }
    }

    private async Task CreateQuiz()
    {
        if (string.IsNullOrWhiteSpace(_newQuiz.Title)) return;
        _isSaving = true;
        var result = await ApiService.CreateClassroomQuizAsync(ClassroomId, _selectedLessonId, _userId, _newQuiz);
        _isSaving = false;
        if (result != null)
        {
            _showCreateQuizDialog = false;
            Snackbar.Add("Quiz-ul a fost creat!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Eroare la crearea quiz-ului.", Severity.Error);
        }
    }

    private async Task CopyCode()
    {
        Snackbar.Add($"Cod copiat: {_classroom?.ClassCode}", Severity.Info);
    }

    private string GetSubjectName(SubjectType type) => type switch
    {
        SubjectType.Mathematics => "MatematicÄƒ",
        SubjectType.Romanian => "RomÃ¢nÄƒ",
        SubjectType.Informatics => "InformaticÄƒ",
        _ => "General"
    };

    private string GetDifficultyName(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Beginner => "ÃŽncepÄƒtor",
        DifficultyLevel.Intermediate => "Intermediar",
        DifficultyLevel.Advanced => "Avansat",
        _ => "N/A"
    };

    private string GetDifficultyStyle(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Beginner => "background:#E8F5E9; color:#2E7D32;",
        DifficultyLevel.Intermediate => "background:#FFF3E0; color:#E65100;",
        DifficultyLevel.Advanced => "background:#FCE4EC; color:#C62828;",
        _ => ""
    };

    private string GetGradeStyle(int value) => value switch
    {
        >= 9 => "background:#E8F5E9; color:#2E7D32; font-weight:700;",
        >= 7 => "background:#E3F2FD; color:#1565C0; font-weight:700;",
        >= 5 => "background:#FFF3E0; color:#E65100; font-weight:700;",
        _ => "background:#FCE4EC; color:#C62828; font-weight:700;"
    };
}

