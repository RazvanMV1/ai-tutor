@page "/subscriptions"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Abonamente - AI Tutor</PageTitle>

<RedirectToLogin />

<!-- Header -->
<MudGrid Class="mb-4">
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-6"
                  Style="border-radius:16px;
                         background:linear-gradient(135deg,#1565C0 0%,#1976D2 50%,#42A5F5 100%);">
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Stars"
                         Style="font-size:2.5rem; color:white;" />
                <div>
                    <MudText Typo="Typo.h5" Style="color:white; font-weight:700;">
                        Abonamente
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.85);">
                        Gestionează abonamentul tău și accesează toate funcționalitățile
                    </MudText>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_isLoading)
{
    <div class="d-flex justify-center align-center" style="height:40vh;">
        <MudProgressCircular Color="Color.Primary"
                             Indeterminate="true"
                             Size="Size.Large" />
    </div>
}
else
{
    <!-- Abonament activ -->
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-5" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="mr-2" />
                    Abonamentul Meu Activ
                </MudText>

                @if (_activeSubscription is null)
                {
                    <MudAlert Severity="Severity.Warning"
                              Style="border-radius:8px;">
                        <MudText Typo="Typo.body2">
                            Nu ai niciun abonament activ. Alege un plan mai jos!
                        </MudText>
                    </MudAlert>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-4 align-center">
                        <div style="padding:20px 32px; border-radius:12px;
                                    background:linear-gradient(135deg,#1565C0,#42A5F5);
                                    color:white; text-align:center; min-width:200px;">
                            <MudText Typo="Typo.h6" Style="color:white; font-weight:700;">
                                @GetSubscriptionName(_activeSubscription.Type)
                            </MudText>
                            <MudText Typo="Typo.h4" Style="color:white; font-weight:900;">
                                @_activeSubscription.Price RON
                            </MudText>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    Status:
                                    <strong style="color:#388E3C;">Activ</strong>
                                </MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday"
                                         Color="Color.Primary" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    Activ din:
                                    <strong>
                                        @_activeSubscription.StartDate.ToString("dd MMM yyyy")
                                    </strong>
                                </MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.EventBusy"
                                         Color="Color.Warning" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    Expiră la:
                                    <strong>
                                        @_activeSubscription.EndDate.ToString("dd MMM yyyy")
                                    </strong>
                                </MudText>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Timer"
                                         Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.body2">
                                    Zile rămase:
                                    <strong style="color:#1976D2;">
                                        @DaysRemaining zile
                                    </strong>
                                </MudText>
                            </div>
                        </div>

                        <MudSpacer />

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Disabled="_isCancelling"
                                   OnClick="@(() => CancelSubscription(
                                       _activeSubscription.Id))">
                            @if (_isCancelling)
                            {
                                <MudProgressCircular Size="Size.Small"
                                                    Indeterminate="true"
                                                    Class="mr-2" />
                            }
                            Anulează abonament
                        </MudButton>
                    </div>

                    <!-- Progress bar expirare -->
                    <div class="mt-4">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Timp utilizat
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @ProgressPercent%
                            </MudText>
                        </div>
                        <MudProgressLinear Value="@ProgressPercent"
                                           Color="@(ProgressPercent > 80
                                               ? Color.Error : Color.Primary)"
                                           Rounded="true"
                                           Size="Size.Medium" />
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Planuri disponibile -->
    <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
        Planuri Disponibile
    </MudText>

    <MudGrid Class="mb-4">
        @foreach (var plan in _plans)
        {
            var isActive = _activeSubscription?.Type == plan.Type;
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="@(plan.IsPopular ? 4 : 2)"
                         Style="@($"border-radius:16px; border:2px solid {(plan.IsPopular ? "#1976D2" : "transparent")}; position:relative; transition:transform 0.2s;")">

                    @if (plan.IsPopular)
                    {
                        <div style="position:absolute; top:-12px; left:50%;
                                    transform:translateX(-50%); z-index:1;">
                            <MudChip T="string" Color="Color.Primary"
                                     Variant="Variant.Filled"
                                     Size="Size.Small">
                                ⭐ Cel mai popular
                            </MudChip>
                        </div>
                    }

                    <MudCardContent Class="pa-5">
                        <div class="text-center mb-4">
                            <div style="font-size:2.5rem; margin-bottom:8px;">
                                @plan.Emoji
                            </div>
                            <MudText Typo="Typo.h6" Style="font-weight:700;">
                                @plan.Name
                            </MudText>
                            <MudText Typo="Typo.h4" Color="Color.Primary"
                                     Style="font-weight:900; margin:8px 0;">
                                @plan.Price RON
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @plan.Period
                            </MudText>
                        </div>

                        <MudDivider Class="mb-3" />

                        <MudList T="string" Dense="true" DisablePadding="true">
                            @foreach (var feature in plan.Features)
                            {
                                <MudListItem T="string" Dense="true">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Check"
                                                 Color="Color.Success"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@feature</MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>

                    <MudCardActions Class="pa-4 pt-0">
                        @if (isActive)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       Disabled="true"
                                       Style="border-radius:8px;">
                                Plan activ
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       Disabled="_isPurchasing"
                                       OnClick="@(() => PurchasePlan(plan))"
                                       Style="border-radius:8px;">
                                @if (_isPurchasing && _purchasingType == plan.Type)
                                {
                                    <MudProgressCircular Size="Size.Small"
                                                        Indeterminate="true"
                                                        Class="mr-2" />
                                }
                                Cumpără acum
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <!-- Istoric abonamente -->
    @if (_allSubscriptions.Count > 1)
    {
        <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
            <MudText Typo="Typo.h6" Class="mb-3" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                Istoric Abonamente
            </MudText>

            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="background:#F5F5F5;">
                            <th style="padding:10px 16px; text-align:left;
                                       font-size:0.75rem; color:#757575;
                                       font-weight:600; text-transform:uppercase;">
                                Plan
                            </th>
                            <th style="padding:10px 16px; text-align:center;
                                       font-size:0.75rem; color:#757575;
                                       font-weight:600; text-transform:uppercase;">
                                Preț
                            </th>
                            <th style="padding:10px 16px; text-align:center;
                                       font-size:0.75rem; color:#757575;
                                       font-weight:600; text-transform:uppercase;">
                                Status
                            </th>
                            <th style="padding:10px 16px; text-align:center;
                                       font-size:0.75rem; color:#757575;
                                       font-weight:600; text-transform:uppercase;">
                                Perioadă
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in _allSubscriptions)
                        {
                            <tr style="border-bottom:1px solid #F0F0F0;">
                                <td style="padding:12px 16px;">
                                    <MudText Typo="Typo.body2" Style="font-weight:500;">
                                        @GetSubscriptionName(sub.Type)
                                    </MudText>
                                </td>
                                <td style="padding:12px 16px; text-align:center;">
                                    <MudText Typo="Typo.body2">
                                        @sub.Price RON
                                    </MudText>
                                </td>
                                <td style="padding:12px 16px; text-align:center;">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(sub.IsActive
                                                 ? Color.Success : Color.Default)"
                                             Variant="Variant.Filled">
                                        @(sub.IsActive ? "Activ" : "Expirat")
                                    </MudChip>
                                </td>
                                <td style="padding:12px 16px; text-align:center;">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @sub.StartDate.ToString("dd MMM yyyy") —
                                        @sub.EndDate.ToString("dd MMM yyyy")
                                    </MudText>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    }
}

@code {
    private bool   _isLoading     = true;
    private bool   _isPurchasing  = false;
    private bool   _isCancelling  = false;
    private int    _purchasingType = 0;

    private SubscriptionDto?       _activeSubscription = null;
    private List<SubscriptionDto>  _allSubscriptions   = [];

    private record PlanInfo(
        int      Type,
        string   Name,
        double   Price,
        string   Period,
        string   Emoji,
        bool     IsPopular,
        string[] Features);

    private readonly List<PlanInfo> _plans =
    [
        new PlanInfo(
            Type:      1,
            Name:      "Lunar",
            Price:     29.99,
            Period:    "pe lună",
            Emoji:     "📅",
            IsPopular: false,
            Features:
            [
                "Acces la toate materiile",
                "Explicații AI nelimitate",
                "Generare probleme AI",
                "Progres detaliat",
                "Anulare oricând"
            ]),
        new PlanInfo(
            Type:      2,
            Name:      "Anual",
            Price:     249.99,
            Period:    "pe an — economisești 110 RON",
            Emoji:     "⭐",
            IsPopular: true,
            Features:
            [
                "Acces la toate materiile",
                "Explicații AI nelimitate",
                "Generare probleme AI",
                "Progres detaliat",
                "Rapoarte pentru părinți",
                "Suport prioritar"
            ]),
        new PlanInfo(
            Type:      3,
            Name:      "Școală",
            Price:     999.99,
            Period:    "per an / clasă",
            Emoji:     "🏫",
            IsPopular: false,
            Features:
            [
                "Până la 35 elevi",
                "Dashboard profesor",
                "Rapoarte detaliate clasă",
                "Creare lecții custom",
                "Suport dedicat",
                "Integrare catalog"
            ]),
    ];

    private int DaysRemaining => _activeSubscription is null
        ? 0
        : Math.Max(0, (int)(_activeSubscription.EndDate - DateTime.UtcNow).TotalDays);

    private double ProgressPercent
    {
        get
        {
            if (_activeSubscription is null) return 0;
            var total   = (_activeSubscription.EndDate -
                           _activeSubscription.StartDate).TotalDays;
            var elapsed = (DateTime.UtcNow -
                           _activeSubscription.StartDate).TotalDays;
            return total > 0
                ? Math.Min(100, Math.Round(elapsed / total * 100))
                : 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadSubscriptionsAsync();
    }

    private async Task LoadSubscriptionsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var user = await AuthService.GetUserAsync();
            if (user is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            _allSubscriptions = await ApiService
                .GetUserSubscriptionsAsync(user.UserId);

            _activeSubscription = _allSubscriptions
                .FirstOrDefault(s => s.IsActive);
        }
        catch
        {
            Snackbar.Add("Nu s-au putut încărca abonamentele.", Severity.Warning);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PurchasePlan(PlanInfo plan)
    {
        var user = await AuthService.GetUserAsync();
        if (user is null) return;

        _isPurchasing  = true;
        _purchasingType = plan.Type;

        try
        {
            var request = new CreateSubscriptionRequest(
                UserId:    user.UserId,
                Type:      plan.Type,
                StartDate: DateTime.UtcNow,
                EndDate:   plan.Type == 1
                    ? DateTime.UtcNow.AddMonths(1)
                    : plan.Type == 2
                        ? DateTime.UtcNow.AddYears(1)
                        : DateTime.UtcNow.AddYears(1));

            await ApiService.CreateSubscriptionAsync(request);

            Snackbar.Add($"Abonament {plan.Name} activat cu succes! 🎉",
                         Severity.Success);
            await LoadSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la cumpărare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isPurchasing   = false;
            _purchasingType = 0;
        }
    }

    private async Task CancelSubscription(Guid subscriptionId)
    {
        var user = await AuthService.GetUserAsync();
        if (user is null) return;

        _isCancelling = true;
        try
        {
            await ApiService.CancelSubscriptionAsync(subscriptionId, user.UserId);
            Snackbar.Add("Abonament anulat.", Severity.Info);
            await LoadSubscriptionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la anulare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private static string GetSubscriptionName(int type) => type switch
    {
        1 => "📅 Lunar",
        2 => "⭐ Anual",
        3 => "🏫 Școală",
        _ => "Necunoscut"
    };
}