@page "/dashboard"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Dashboard - AI Tutor</PageTitle>

<RedirectToLogin />

@if (_isLoading)
{
    <div class="d-flex justify-center align-center" style="height:60vh;">
        <div class="d-flex flex-column align-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Primary">
                Se încarcă datele...
            </MudText>
        </div>
    </div>
}
else
{
    <!-- Header salut -->
    <MudGrid Class="mb-4">
        <MudItem xs="12">
            <MudPaper Elevation="2" Class="pa-6"
                      Style="border-radius:16px;
                             background:linear-gradient(135deg,#1565C0 0%,#1976D2 50%,#42A5F5 100%);">
                <div class="d-flex justify-space-between align-center flex-wrap gap-4">
                    <div>
                        <MudText Typo="Typo.h4" Style="color:white; font-weight:700;">
                            👋 Bună ziua, @_userName!
                        </MudText>
                        <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.85);">
                            Continuă să înveți — fiecare lecție te aduce mai aproape de succes!
                        </MudText>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.AutoAwesome"
                                   Style="background:rgba(255,255,255,0.2); color:white; border-radius:8px;"
                                   Href="/ai/explanation">
                            Explicații AI
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Psychology"
                                   Style="background:rgba(255,255,255,0.2); color:white; border-radius:8px;"
                                   Href="/ai/problems">
                            Probleme AI
                        </MudButton>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Statistici rapide -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4"
                      Style="border-radius:12px; border-left:4px solid #1976D2;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">TOTAL LECȚII</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight:700;">
                            @_totalLessons
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                             Style="font-size:2.5rem; color:#E3F2FD;" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4"
                      Style="border-radius:12px; border-left:4px solid #388E3C;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">LECȚII COMPLETATE</MudText>
                        <MudText Typo="Typo.h4" Style="color:#388E3C; font-weight:700;">
                            @_completedLessons
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                             Style="font-size:2.5rem; color:#E8F5E9;" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4"
                      Style="border-radius:12px; border-left:4px solid #F57C00;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">SCOR MEDIU</MudText>
                        <MudText Typo="Typo.h4" Style="color:#F57C00; font-weight:700;">
                            @_averageScore%
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Star"
                             Style="font-size:2.5rem; color:#FFF3E0;" />
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4"
                      Style="border-radius:12px; border-left:4px solid #7B1FA2;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">PROGRES GENERAL</MudText>
                        <MudText Typo="Typo.h4" Style="color:#7B1FA2; font-weight:700;">
                            @_progressPercent%
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                             Style="font-size:2.5rem; color:#F3E5F5;" />
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Grafice vizuale custom -->
    <MudGrid Class="mb-4">
        <!-- Grafic circular custom - Progres lecții -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="mr-2" />
                    Progres Lecții
                </MudText>

                <!-- Cerc SVG custom -->
                <div class="d-flex justify-center align-center" style="height:200px;">
                    <div style="position:relative; width:180px; height:180px;">
                        <svg width="180" height="180" viewBox="0 0 180 180">
                            <!-- Cerc fundal -->
                            <circle cx="90" cy="90" r="70"
                                    fill="none" stroke="#E3F2FD" stroke-width="20" />
                            <!-- Cerc progres -->
                            <circle cx="90" cy="90" r="70"
                                    fill="none" stroke="#1976D2" stroke-width="20"
                                    stroke-dasharray="@_circumference"
                                    stroke-dashoffset="@_dashOffset"
                                    stroke-linecap="round"
                                    transform="rotate(-90 90 90)" />
                        </svg>
                        <div style="position:absolute; top:50%; left:50%;
                                    transform:translate(-50%,-50%); text-align:center;">
                            <div style="font-size:1.8rem; font-weight:700; color:#1976D2;">
                                @_progressPercent%
                            </div>
                            <div style="font-size:0.75rem; color:#757575;">completat</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-center gap-4 mt-2">
                    <div class="d-flex align-center gap-1">
                        <div style="width:12px; height:12px; border-radius:50%;
                                    background:#1976D2;"></div>
                        <MudText Typo="Typo.caption">Completate (@_completedLessons)</MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <div style="width:12px; height:12px; border-radius:50%;
                                    background:#E3F2FD; border:1px solid #BDBDBD;"></div>
                        <MudText Typo="Typo.caption">
                            Rămase (@(_totalLessons - _completedLessons))
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Grafic bare custom - Scor per materie -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="mr-2" />
                    Scor Mediu per Materie
                </MudText>

                <div style="height:200px; display:flex; align-items:flex-end;
                            justify-content:space-around; padding:0 16px; gap:16px;">
                    <!-- Matematică -->
                    <div class="d-flex flex-column align-center" style="flex:1;">
                        <MudText Typo="Typo.caption" Style="font-weight:600; color:#1976D2;">
                            @_mathProgress%
                        </MudText>
                        <div style="width:100%; background:#1976D2; border-radius:4px 4px 0 0;
                                    height:@(_mathProgress * 1.5)px;
                                    transition:height 0.5s ease;
                                    min-height:4px;">
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-1" Align="Align.Center">
                            📐 Mat.
                        </MudText>
                    </div>
                    <!-- Română -->
                    <div class="d-flex flex-column align-center" style="flex:1;">
                        <MudText Typo="Typo.caption" Style="font-weight:600; color:#388E3C;">
                            @_romanianProgress%
                        </MudText>
                        <div style="width:100%; background:#388E3C; border-radius:4px 4px 0 0;
                                    height:@(_romanianProgress * 1.5)px;
                                    transition:height 0.5s ease;
                                    min-height:4px;">
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-1" Align="Align.Center">
                            📖 Ro.
                        </MudText>
                    </div>
                    <!-- Informatică -->
                    <div class="d-flex flex-column align-center" style="flex:1;">
                        <MudText Typo="Typo.caption" Style="font-weight:600; color:#7B1FA2;">
                            @_informaticsProgress%
                        </MudText>
                        <div style="width:100%; background:#7B1FA2; border-radius:4px 4px 0 0;
                                    height:@(_informaticsProgress * 1.5)px;
                                    transition:height 0.5s ease;
                                    min-height:4px;">
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-1" Align="Align.Center">
                            💻 Info.
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Progres per materie + Activitate recentă -->
    <MudGrid>
        <!-- Progres linear -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
                    Progres per Materie
                </MudText>

                <div class="mb-4">
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2">📐 Matematică</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Primary">
                            @_mathProgress%
                        </MudText>
                    </div>
                    <MudProgressLinear Value="@_mathProgress"
                                       Color="Color.Primary"
                                       Rounded="true"
                                       Size="Size.Medium" />
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2">📖 Română</MudText>
                        <MudText Typo="Typo.body2" Style="color:#388E3C;">
                            @_romanianProgress%
                        </MudText>
                    </div>
                    <MudProgressLinear Value="@_romanianProgress"
                                       Color="Color.Secondary"
                                       Rounded="true"
                                       Size="Size.Medium" />
                </div>

                <div>
                    <div class="d-flex justify-space-between mb-1">
                        <MudText Typo="Typo.body2">💻 Informatică</MudText>
                        <MudText Typo="Typo.body2" Style="color:#7B1FA2;">
                            @_informaticsProgress%
                        </MudText>
                    </div>
                    <MudProgressLinear Value="@_informaticsProgress"
                                       Color="Color.Tertiary"
                                       Rounded="true"
                                       Size="Size.Medium" />
                </div>
            </MudPaper>
        </MudItem>

        <!-- Activitate recentă -->
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                    Activitate Recentă
                </MudText>

                @if (_recentActivity.Count == 0)
                {
                    <div class="d-flex flex-column align-center justify-center"
                         style="height:200px;">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty"
                                 Style="font-size:3rem; color:#BDBDBD;" />
                        <MudText Color="Color.Secondary" Class="mt-2">
                            Nicio activitate înregistrată încă.
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Href="/subjects"
                                   Class="mt-3"
                                   Size="Size.Small">
                            Începe prima lecție
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var item in _recentActivity)
                        {
                            <MudListItem T="string">
                                <div class="d-flex justify-space-between align-center w-100">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@(item.IsCompleted
                                                     ? Icons.Material.Filled.CheckCircle
                                                     : Icons.Material.Filled.RadioButtonUnchecked)"
                                                 Color="@(item.IsCompleted
                                                     ? Color.Success : Color.Default)"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@item.LessonTitle</MudText>
                                    </div>
                                    @if (item.IsCompleted)
                                    {
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="Color.Success"
                                                 Variant="Variant.Filled">
                                            @item.ScorePercentage%
                                        </MudChip>
                                    }
                                </div>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool   _isLoading = true;
    private string _userName  = "Utilizator";

    // Statistici
    private int _totalLessons      = 0;
    private int _completedLessons  = 0;
    private int _averageScore      = 0;
    private int _progressPercent   = 0;

    // Progres per materie
    private double _mathProgress        = 0;
    private double _romanianProgress    = 0;
    private double _informaticsProgress = 0;

    // SVG cerc
    private double _circumference => 2 * Math.PI * 70;
    private double _dashOffset    => _circumference * (1 - _progressPercent / 100.0);

    // Activitate recentă
    private List<StudentProgressDto> _recentActivity = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var user = await AuthService.GetUserAsync();
        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _userName = user.FullName.Split(' ')[0];
        await LoadDataAsync(user.Id);
    }

    private async Task LoadDataAsync(Guid userId)
    {
        try
        {
            var progress = await ApiService.GetProgressAsync(userId);

            _totalLessons     = progress.Count;
            _completedLessons = progress.Count(p => p.IsCompleted);
            _progressPercent  = _totalLessons > 0
                ? (int)Math.Round((double)_completedLessons / _totalLessons * 100)
                : 0;

            var completed = progress.Where(p => p.IsCompleted).ToList();
            _averageScore = completed.Count > 0
                ? (int)Math.Round(completed.Average(p => p.ScorePercentage))
                : 0;

            _mathProgress        = GetAverageScoreForSubject(completed, "mat");
            _romanianProgress    = GetAverageScoreForSubject(completed, "rom");
            _informaticsProgress = GetAverageScoreForSubject(completed, "inf");

            _recentActivity = progress
                .OrderByDescending(p => p.CompletedAt ?? DateTime.MinValue)
                .Take(5)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Backend indisponibil — se afișează date demo. ({ex.Message})",
                         Severity.Info);
            LoadDemoData();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static double GetAverageScoreForSubject(
        List<StudentProgressDto> items, string keyword)
    {
        var filtered = items
            .Where(p => p.LessonTitle.Contains(keyword,
                StringComparison.OrdinalIgnoreCase))
            .ToList();

        return filtered.Count > 0
            ? Math.Round(filtered.Average(p => p.ScorePercentage))
            : 0;
    }

    private void LoadDemoData()
    {
        _totalLessons        = 12;
        _completedLessons    = 7;
        _averageScore        = 78;
        _progressPercent     = 58;
        _mathProgress        = 75;
        _romanianProgress    = 60;
        _informaticsProgress = 85;

        _recentActivity =
        [
            new StudentProgressDto(Guid.NewGuid(), "Ecuații de gradul I",
                true,  85, 1, DateTime.Now.AddDays(-1)),
            new StudentProgressDto(Guid.NewGuid(), "Substantivul",
                true,  72, 2, DateTime.Now.AddDays(-2)),
            new StudentProgressDto(Guid.NewGuid(), "Algoritmi de sortare",
                true,  90, 1, DateTime.Now.AddDays(-3)),
            new StudentProgressDto(Guid.NewGuid(), "Fracții ordinare",
                false,  0, 0, null),
            new StudentProgressDto(Guid.NewGuid(), "Verbul",
                false,  0, 0, null),
        ];
    }
}