@page "/classrooms/{ClassroomId:guid}"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Detalii Clasă | AiTutor</PageTitle>

@if (_isLoading)
{
    <div style="padding:24px;">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Style="border-radius:16px; margin-bottom:24px;" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="48px" Style="border-radius:8px; margin-bottom:16px;" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Style="border-radius:16px;" />
    </div>
}
else if (_classroom == null)
{
    <div style="padding:24px; text-align:center;">
        <MudText Typo="Typo.h6" Style="color:#546E7A;">Clasa nu a fost găsită.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='() => Navigation.NavigateTo("/classrooms")' Class="mt-4">
            Înapoi la Clase
        </MudButton>
    </div>
}
else
{
    <div class="page-fade-in" style="padding:24px; max-width:1200px; margin:0 auto;">

        <!-- Header -->
        <div style="background:linear-gradient(135deg,#1976D2,#42A5F5); border-radius:16px; padding:24px; margin-bottom:24px; color:white;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                <div>
                    <MudButton Variant="Variant.Text" Style="color:rgba(255,255,255,0.8); margin-bottom:8px; padding:0;"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick='() => Navigation.NavigateTo("/classrooms")'>
                        Înapoi
                    </MudButton>
                    <MudText Typo="Typo.h4" Style="font-weight:700; color:white;">@_classroom.Name</MudText>
                    @if (!string.IsNullOrEmpty(_classroom.Description))
                    {
                        <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.85); margin-top:4px;">@_classroom.Description</MudText>
                    }
                    <div style="display:flex; gap:16px; margin-top:12px; flex-wrap:wrap;">
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size:16px; margin-right:4px;" />
                            @_classroom.MemberCount / @_classroom.MaxStudents elevi
                        </MudChip>
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:16px; margin-right:4px;" />
                            @_classroom.LessonCount lecții
                        </MudChip>
                        <MudChip T="string" Style="background:rgba(255,255,255,0.2); color:white;">
                            @GetSubjectName(_classroom.SubjectType)
                        </MudChip>
                    </div>
                </div>
                @if (_isTeacher)
                {
                    <div style="background:rgba(255,255,255,0.15); border-radius:12px; padding:12px 20px; text-align:center;">
                        <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,0.7); display:block;">Cod Clasă</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight:800; letter-spacing:4px; color:white;">@_classroom.ClassCode</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Style="color:rgba(255,255,255,0.8);"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyCode">
                            Copiază
                        </MudButton>
                    </div>
                }
            </div>
        </div>

        <!-- Tabs -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true"
                 Style="background:white; border-radius:16px; padding:8px;">
            <!-- Lecții -->
            <MudTabPanel Text="Lecții" Icon="@Icons.Material.Filled.MenuBook">
                <div style="padding:16px;">
                    @if (_isTeacher)
                    {
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenCreateLessonDialog"
                                       Style="border-radius:12px;">
                                Lecție Nouă
                            </MudButton>
                        </div>
                    }
                    @if (_lessons.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu există lecții în această clasă.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudList T="ClassroomLessonDto">
                            @foreach (var lesson in _lessons.OrderBy(l => l.OrderIndex))
                            {
                                <MudListItem T="ClassroomLessonDto">
                                    <MudPaper Class="pa-3 mb-2" Style="border-radius:12px; border:1px solid #E0E0E0;">
                                    <div style="cursor:pointer;" @onclick="() => OpenViewLessonDialog(lesson)">
                                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                            <div style="flex:1; min-width:0;">
                                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                                    <MudText Typo="Typo.body1" Style="font-weight:600;">@lesson.Title</MudText>
                                                    <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(lesson.Difficulty)">
                                                        @GetDifficultyName(lesson.Difficulty)
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.caption" Style="color:#90A4AE;">
                                                    Lecția @lesson.OrderIndex
                                                </MudText>
                                            </div>
                                            @if (_isTeacher)
                                            {
                                                <div style="display:flex; gap:4px; align-items:center;" @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                Color="Color.Primary" Size="Size.Small"
                                                                OnClick="@(() => OpenEditLessonDialog(lesson))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                Color="Color.Error" Size="Size.Small"
                                                                OnClick="@(() => DeleteLesson(lesson.Id))" />
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                            Color="Color.Primary"
                                                            OnClick="@(() => OpenCreateQuizDialog(lesson.Id))">
                                                        + Quiz
                                                    </MudButton>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @if (_quizzesByLesson.ContainsKey(lesson.Id) && _quizzesByLesson[lesson.Id].Count > 0)
                                    {
                                        <MudDivider Class="my-2" />
                                        <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600; margin-bottom:6px; display:block;">
                                            Quiz-uri:
                                        </MudText>
                                        @foreach (var quiz in _quizzesByLesson[lesson.Id])
                                        {
                                            <div style="display:flex; align-items:center; gap:8px; padding:6px 8px; background:#F5F7FA; border-radius:6px; margin-bottom:4px; cursor:pointer;"
                                                @onclick="() => OpenViewQuizDialog(quiz.Id)">
                                                <MudIcon Icon="@Icons.Material.Filled.Quiz" Style="color:#1976D2; font-size:18px;" />
                                                <div style="flex:1;">
                                                    <MudText Typo="Typo.body2" Style="font-weight:600;">@quiz.Title</MudText>
                                                    <MudText Typo="Typo.caption" Style="color:#90A4AE;">
                                                        @quiz.QuestionCount întrebări · @quiz.TimeLimitMinutes min
                                                    </MudText>
                                                </div>
                                                @if (_isTeacher)
                                                {
                                                    <div style="display:flex; gap:2px;" @onclick:stopPropagation="true">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                    Color="Color.Primary" Size="Size.Small"
                                                                    OnClick="@(() => OpenEditQuizDialog(quiz))" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                    Color="Color.Error" Size="Size.Small"
                                                                    OnClick="@(() => DeleteQuiz(quiz.Id))" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </MudPaper>

                                </MudListItem>
                            }
                        </MudList>
                    }
                </div>
            </MudTabPanel>

            <!-- Elevi -->
            <MudTabPanel Text="Elevi" Icon="@Icons.Material.Filled.People">
                <div style="padding:16px;">
                    @if (_isTeacher)
                    {
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddMemberDialog"
                                       Style="border-radius:12px;">
                                Adaugă Elev
                            </MudButton>
                        </div>
                    }
                    @if (_members.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.People" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu există elevi înscriși.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_members" Hover="true" Striped="true" Style="border-radius:12px;">
                            <HeaderContent>
                                <MudTh>Nume</MudTh>
                                <MudTh>Email</MudTh>
                                <MudTh>Data înscrierii</MudTh>
                                @if (_isTeacher)
                                {
                                    <MudTh>Acțiuni</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <MudAvatar Style="background:#1976D2; color:white; width:32px; height:32px; font-size:14px;">
                                            @context.FullName.FirstOrDefault()
                                        </MudAvatar>
                                        @context.FullName
                                    </div>
                                </MudTd>
                                <MudTd>@context.Email</MudTd>
                                <MudTd>@context.JoinedAt.ToString("dd MMM yyyy")</MudTd>
                                @if (_isTeacher)
                                {
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => RemoveMember(context.StudentId)" />
                                    </MudTd>
                                }
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- Catalog -->
            @if (_isTeacher)
            {
                <MudTabPanel Text="Catalog" Icon="@Icons.Material.Filled.Grade">
                    <div style="padding:16px;">
                        <div style="display:flex; justify-content:flex-end; margin-bottom:16px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenAddGradeDialog"
                                       Style="border-radius:12px;">
                                Adaugă Notă
                            </MudButton>
                        </div>
                        @if (_grades.Count == 0)
                        {
                            <div style="text-align:center; padding:32px;">
                                <MudIcon Icon="@Icons.Material.Filled.Grade" Style="font-size:48px; color:#B0BEC5;" />
                                <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu există note în catalog.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudTable Items="_grades" Hover="true" Striped="true" Style="border-radius:12px;">
                                <HeaderContent>
                                    <MudTh>Elev</MudTh>
                                    <MudTh>Notă</MudTh>
                                    <MudTh>Descriere</MudTh>
                                    <MudTh>Data</MudTh>
                                    <MudTh>Acțiuni</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>@context.StudentName</MudTd>
                                    <MudTd>
                                        <MudChip T="string" Style="@GetGradeStyle(context.Value)" Size="Size.Small">
                                            @context.Value
                                        </MudChip>
                                    </MudTd>
                                    <MudTd>@(context.Description ?? "-")</MudTd>
                                    <MudTd>@context.GradedAt.ToString("dd MMM yyyy")</MudTd>
                                    <MudTd>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => DeleteGrade(context.Id)" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </div>
                </MudTabPanel>
            }

            <!-- Progres -->
            <MudTabPanel Text="Progres" Icon="@Icons.Material.Filled.TrendingUp">
                <div style="padding:16px;">
                    @if (_progress.Count == 0)
                    {
                        <div style="text-align:center; padding:32px;">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="font-size:48px; color:#B0BEC5;" />
                            <MudText Typo="Typo.body1" Style="color:#546E7A; margin-top:8px;">Nu există date de progres.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudTable Items="_progress" Hover="true" Striped="true" Style="border-radius:12px;">
                            <HeaderContent>
                                @if (_isTeacher)
                                {
                                    <MudTh>Elev</MudTh>
                                }
                                <MudTh>Lecție</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Scor</MudTh>
                                <MudTh>Încercări</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @if (_isTeacher)
                                {
                                    <MudTd>@context.StudentName</MudTd>
                                }
                                <MudTd>@context.LessonTitle</MudTd>
                                <MudTd>
                                    @if (context.IsCompleted)
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background:#E8F5E9; color:#2E7D32;">Completat</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Style="background:#FFF3E0; color:#E65100;">În progres</MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <MudProgressLinear Value="@context.ScorePercentage" Style="width:80px;" Color="Color.Primary" />
                                        <MudText Typo="Typo.caption">@context.ScorePercentage%</MudText>
                                    </div>
                                </MudTd>
                                <MudTd>@context.AttemptsCount</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
}

<!-- Create Lesson Dialog -->
<MudDialog @bind-Visible="_showCreateLessonDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Lecție Nouă</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newLesson.Title" Label="Titlu lecție" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_newLesson.Content" Label="Conținut"
                      Variant="Variant.Outlined" Lines="5" Class="mb-3" />
        <MudNumericField @bind-Value="_newLesson.OrderIndex" Label="Ordinea lecției"
                         Min="1" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_newLesson.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined">
            <MudSelectItem Value="DifficultyLevel.Beginner">Începător</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showCreateLessonDialog = false">Anulează</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="CreateLesson" Disabled="_isSaving">
            Creează
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- View Lesson Dialog -->
<MudDialog @bind-Visible="_showViewLessonDialog" Options="_viewLessonOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight:700;">
            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Class="mr-2" Style="color:#1976D2;" />
            @(_viewedLesson?.Title ?? "Lecție")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_viewedLesson != null)
        {
            <div style="display:flex; gap:8px; margin-bottom:12px; flex-wrap:wrap;">
                <MudChip T="string" Size="Size.Small" Style="@GetDifficultyStyle(_viewedLesson.Difficulty)">
                    @GetDifficultyName(_viewedLesson.Difficulty)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Style="background:#E3F2FD; color:#1565C0;">
                    Lecția @_viewedLesson.OrderIndex
                </MudChip>
            </div>
            <MudText Typo="Typo.subtitle2" Style="color:#546E7A; margin-bottom:8px;">Conținut:</MudText>
            <MudPaper Class="pa-3" Style="background:#F5F7FA; border-radius:8px; max-height:400px; overflow-y:auto;">
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">
                    @(string.IsNullOrWhiteSpace(_viewedLesson.Content) ? "(fără conținut)" : _viewedLesson.Content)
                </MudText>
            </MudPaper>

            <div style="margin-top:16px; display:flex; justify-content:center;">
                <MudButton Variant="Variant.Filled"
                           Style="background:linear-gradient(135deg,#7B1FA2,#E91E63); color:white; border-radius:24px; padding:8px 24px; font-weight:700;"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="OpenAiTutorDialog">
                    ✨ Întreabă AI-ul despre lecție
                </MudButton>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showViewLessonDialog = false">Închide</MudButton>
        @if (_isTeacher && _viewedLesson != null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="@(() => { _showViewLessonDialog = false; OpenEditLessonDialog(_viewedLesson); })">
                Editează
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- Edit Lesson Dialog -->
<MudDialog @bind-Visible="_showEditLessonDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Editează Lecție</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_editLesson.Title" Label="Titlu lecție" Required="true"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_editLesson.Content" Label="Conținut"
                      Variant="Variant.Outlined" Lines="6" Class="mb-3" />
        <MudSelect T="DifficultyLevel" @bind-Value="_editLesson.Difficulty"
                   Label="Dificultate" Variant="Variant.Outlined">
            <MudSelectItem Value="DifficultyLevel.Beginner">Începător</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Intermediate">Intermediar</MudSelectItem>
            <MudSelectItem Value="DifficultyLevel.Advanced">Avansat</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showEditLessonDialog = false">Anulează</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="UpdateLesson" Disabled="_isSaving">
            Salvează
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- AI Tutor Chat Dialog -->
<MudDialog @bind-Visible="_showAiTutorDialog" Options="_aiDialogOptions">
    <TitleContent>
        <div style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;">
            <MudText Typo="Typo.h6" Style="font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" Style="color:#7B1FA2;" />
                Tutor AI · @(_viewedLesson?.Title ?? "")
            </MudText>
            @if (_aiHistory.Count > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="ResetAiConversation"
                           Disabled="_aiIsLoading">
                    Conversație nouă
                </MudButton>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <div style="background:#F5F7FA; border-radius:12px; padding:12px; min-height:280px; max-height:420px; overflow-y:auto;">
            @if (_aiHistory.Count == 0 && !_aiIsLoading)
            {
                <div style="text-align:center; padding:32px 16px; color:#90A4AE;">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size:48px; color:#B39DDB;" />
                    <MudText Typo="Typo.body1" Class="mt-2" Style="color:#546E7A; font-weight:600;">
                        Salut! Sunt aici să te ajut cu lecția.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mt-1" Style="color:#78909C;">
                        Pune o întrebare despre conținutul lecției și îți voi explica.
                    </MudText>
                </div>
            }
            else
            {
                @foreach (var msg in _aiHistory)
                {
                    var isUser = msg.Role == "user";
                    <div style="@($"display:flex; justify-content:{(isUser ? "flex-end" : "flex-start")}; margin-bottom:10px;")">
                        <div style="@($"max-width:85%; padding:10px 14px; border-radius:14px; {(isUser ? "background:#1976D2; color:white; border-bottom-right-radius:4px;" : "background:white; color:#263238; border:1px solid #E0E0E0; border-bottom-left-radius:4px;")}")">
                            @if (!isUser)
                            {
                                <div style="display:flex; align-items:center; gap:4px; margin-bottom:4px;">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size:14px; color:#7B1FA2;" />
                                    <MudText Typo="Typo.caption" Style="color:#7B1FA2; font-weight:700;">Tutor AI</MudText>
                                </div>
                            }
                            <MudText Typo="Typo.body2" Style="@($"white-space:pre-wrap; {(isUser ? "color:white;" : "color:#263238;")}")">
                                @msg.Content
                            </MudText>
                        </div>
                    </div>
                }
                @if (_aiIsLoading)
                {
                    <div style="display:flex; justify-content:flex-start; margin-bottom:10px;">
                        <div style="padding:10px 14px; border-radius:14px; background:white; border:1px solid #E0E0E0; border-bottom-left-radius:4px; display:flex; align-items:center; gap:8px;">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Style="color:#7B1FA2; font-style:italic;">AI-ul se gândește...</MudText>
                        </div>
                    </div>
                }
            }
        </div>

        <div style="display:flex; gap:8px; align-items:flex-end; margin-top:12px;">
            <MudTextField @bind-Value="_aiInput"
                          Placeholder="Scrie o întrebare despre lecție..."
                          Variant="Variant.Outlined"
                          Lines="2"
                          Immediate="true"
                          OnKeyDown="HandleAiInputKeyDown"
                          Disabled="_aiIsLoading"
                          Style="flex:1;" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SendAiQuestion"
                       Disabled="@(_aiIsLoading || string.IsNullOrWhiteSpace(_aiInput))"
                       Style="height:56px;">
                Trimite
            </MudButton>
        </div>
