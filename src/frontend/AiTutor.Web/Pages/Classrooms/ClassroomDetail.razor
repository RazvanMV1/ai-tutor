@code {
    [Parameter] public Guid ClassroomId { get; set; }

    private ClassroomDto? _classroom;
    private List<ClassroomLessonDto> _lessons = new();
    private List<ClassroomMemberDto> _members = new();
    private List<GradeDto> _grades = new();
    private List<ClassroomProgressDto> _progress = new();
    private bool _isLoading = true;
    private bool _isTeacher = false;
    private bool _isSaving = false;
    private Guid _userId;

    private bool _showCreateLessonDialog = false;
    private bool _showAddMemberDialog = false;
    private bool _showAddGradeDialog = false;
    private bool _showCreateQuizDialog = false;
    private bool _showViewLessonDialog = false;
    private bool _showEditLessonDialog = false;
    private Guid _selectedLessonId;
    private Guid _editingLessonId;
    private ClassroomLessonDto? _viewedLesson;

    private CreateClassroomLessonRequest _newLesson = new();
    private CreateClassroomQuizRequest _newQuiz = new();
    private AddGradeRequest _newGrade = new();
    private UpdateClassroomLessonRequest _editLesson = new();
    private string _memberEmail = string.Empty;

    private bool _showViewQuizDialog = false;
    private bool _showEditQuizDialog = false;
    private bool _showAddQuestionDialog = false;
    private ClassroomQuizDetailDto? _viewedQuiz;
    private Guid _editingQuizId;
    private UpdateClassroomQuizRequest _editQuiz = new();
    private AddClassroomQuestionRequest _newQuestion = new();
    private List<string> _newQuestionOptions = new() { "", "" };
    private Dictionary<Guid, List<ClassroomQuizDto>> _quizzesByLesson = new();

    // ===== STUDENT QUIZ ATTEMPT =====
    private Dictionary<Guid, string> _studentAnswers = new();
    private ClassroomQuizResultResponse? _quizSubmitResult;

    // ===== TIMER =====
    private System.Threading.Timer? _quizTimer;
    private int _remainingSeconds = 0;
    private int _totalSeconds = 0;
    private bool _timeExpired = false;

    // ===== AI TUTOR CHAT =====
    private bool _showAiTutorDialog = false;
    private List<LessonChatMessage> _aiHistory = new();
    private string _aiInput = string.Empty;
    private bool _aiIsLoading = false;

    private DialogOptions _viewLessonOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    private DialogOptions _viewQuizOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    private DialogOptions _aiDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    protected override async Task OnInitializedAsync()
    {
        var userId = await AuthService.GetCurrentUserIdAsync();
        var role = await AuthService.GetCurrentUserRoleAsync();
        if (userId == Guid.Empty)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        _userId = userId;
        _isTeacher = role == UserRole.Teacher || role == UserRole.Admin;
        await LoadData();
    }

    public void Dispose()
    {
        StopTimer();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _classroom = await ApiService.GetClassroomByIdAsync(ClassroomId, _userId);
        if (_classroom != null)
        {
            var tasks = new List<Task>
            {
                LoadLessons(),
                LoadProgress()
            };
            if (_isTeacher)
            {
                tasks.Add(LoadMembers());
                tasks.Add(LoadGrades());
            }
            await Task.WhenAll(tasks);
        }
        _isLoading = false;
    }

    private async Task LoadLessons()
    {
        _lessons = await ApiService.GetClassroomLessonsAsync(ClassroomId, _userId);
        _quizzesByLesson.Clear();
        foreach (var l in _lessons)
        {
            var quizzes = await ApiService.GetClassroomQuizzesByLessonAsync(ClassroomId, l.Id, _userId);
            _quizzesByLesson[l.Id] = quizzes;
        }
    }


    private async Task LoadMembers() =>
        _members = await ApiService.GetClassroomMembersAsync(ClassroomId, _userId);

    private async Task LoadGrades() =>
        _grades = await ApiService.GetClassroomGradesAsync(ClassroomId, _userId, _isTeacher);

    private async Task LoadProgress() =>
        _progress = await ApiService.GetClassroomProgressAsync(ClassroomId, _userId);

    private void OpenCreateLessonDialog()
    {
        _newLesson = new CreateClassroomLessonRequest();
        _showCreateLessonDialog = true;
    }

    private void OpenAddMemberDialog()
    {
        _memberEmail = string.Empty;
        _showAddMemberDialog = true;
    }

    private void OpenAddGradeDialog()
    {
        _newGrade = new AddGradeRequest { Value = 5 };
        _showAddGradeDialog = true;
    }

    private void OpenCreateQuizDialog(Guid lessonId)
    {
        _selectedLessonId = lessonId;
        _newQuiz = new CreateClassroomQuizRequest();
        _showCreateQuizDialog = true;
    }

    private void OpenViewLessonDialog(ClassroomLessonDto lesson)
    {
        _viewedLesson = lesson;
        _showViewLessonDialog = true;
    }

    // ===== AI TUTOR =====
    private void OpenAiTutorDialog()
    {
        if (_viewedLesson == null) return;
        _aiHistory = new List<LessonChatMessage>();
        _aiInput = string.Empty;
        _aiIsLoading = false;
        _showAiTutorDialog = true;
    }

    private void CloseAiTutorDialog()
    {
        _showAiTutorDialog = false;
    }

    private void ResetAiConversation()
    {
        _aiHistory = new List<LessonChatMessage>();
        _aiInput = string.Empty;
    }

    private async Task HandleAiInputKeyDown(KeyboardEventArgs e)
    {
        // Enter trimite, Shift+Enter face linie nouă
        if (e.Key == "Enter" && !e.ShiftKey && !_aiIsLoading && !string.IsNullOrWhiteSpace(_aiInput))
        {
            await SendAiQuestion();
        }
    }

    private async Task SendAiQuestion()
    {
        if (_viewedLesson == null) return;
        if (string.IsNullOrWhiteSpace(_aiInput)) return;

        var question = _aiInput.Trim();
        _aiInput = string.Empty;

        // Adaugă întrebarea în istoric ca să apară imediat în UI
        _aiHistory.Add(new LessonChatMessage { Role = "user", Content = question });
        _aiIsLoading = true;
        StateHasChanged();

        // Construim history-ul DOAR cu mesajele anterioare (fără întrebarea curentă)
        var historyToSend = _aiHistory
            .Take(_aiHistory.Count - 1)
            .Select(m => new LessonChatMessage { Role = m.Role, Content = m.Content })
            .ToList();

        var subject = _classroom?.SubjectType ?? SubjectType.Mathematics;

        var request = new LessonChatRequest
        {
            LessonTitle = _viewedLesson.Title,
            LessonContent = _viewedLesson.Content ?? string.Empty,
            Subject = subject,
            DifficultyLevel = _viewedLesson.Difficulty,
            Question = question,
            History = historyToSend
        };

        var response = await ApiService.AskLessonAiAsync(request);

        _aiIsLoading = false;
        if (response != null && !string.IsNullOrWhiteSpace(response.Answer))
        {
            _aiHistory.Add(new LessonChatMessage { Role = "assistant", Content = response.Answer });
        }
        else
        {
            _aiHistory.Add(new LessonChatMessage
            {
                Role = "assistant",
                Content = "Îmi pare rău, am întâmpinat o eroare. Te rog încearcă din nou peste câteva momente."
            });
            Snackbar.Add("Eroare la comunicarea cu tutorul AI.", Severity.Error);
        }
        StateHasChanged();
    }

    private async Task OpenViewQuizDialog(Guid quizId)
    {
        var quiz = await ApiService.GetClassroomQuizByIdAsync(ClassroomId, quizId, _userId);
        if (quiz != null)
        {
            _viewedQuiz = quiz;
            _studentAnswers = new Dictionary<Guid, string>();
            _quizSubmitResult = null;
            _timeExpired = false;
            _showViewQuizDialog = true;

            if (!_isTeacher && quiz.Questions.Count > 0 && quiz.TimeLimitMinutes > 0)
            {
                StartTimer(quiz.TimeLimitMinutes * 60);
            }
        }
        else
        {
            Snackbar.Add("Eroare la încărcarea quiz-ului.", Severity.Error);
        }
    }

    private void StartTimer(int totalSeconds)
    {
        StopTimer();
        _totalSeconds = totalSeconds;
        _remainingSeconds = totalSeconds;
        _quizTimer = new System.Threading.Timer(async _ =>
        {
            _remainingSeconds--;
            if (_remainingSeconds <= 0)
            {
                _remainingSeconds = 0;
                StopTimer();
                _timeExpired = true;
                await InvokeAsync(async () =>
                {
                    Snackbar.Add("⏱ Timpul a expirat! Quiz-ul se trimite automat.", Severity.Warning);
                    await SubmitStudentQuiz(true);
                });
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private void StopTimer()
    {
        _quizTimer?.Dispose();
        _quizTimer = null;
    }

    private string FormatTime(int totalSeconds)
    {
        if (totalSeconds < 0) totalSeconds = 0;
        var m = totalSeconds / 60;
        var s = totalSeconds % 60;
        return $"{m:D2}:{s:D2}";
    }

    private string GetTimerBg()
    {
        if (_totalSeconds == 0) return "#E3F2FD";
        var ratio = (double)_remainingSeconds / _totalSeconds;
        if (ratio <= 0.10) return "#FFEBEE";
        if (ratio <= 0.25) return "#FFF3E0";
        return "#E3F2FD";
    }

    private string GetTimerFg()
    {
        if (_totalSeconds == 0) return "#1565C0";
        var ratio = (double)_remainingSeconds / _totalSeconds;
        if (ratio <= 0.10) return "#C62828";
        if (ratio <= 0.25) return "#E65100";
        return "#1565C0";
    }

    private void CloseQuizDialog()
    {
        StopTimer();
        _showViewQuizDialog = false;
        _studentAnswers = new Dictionary<Guid, string>();
        _quizSubmitResult = null;
        _timeExpired = false;
    }

    private void ResetQuizAttempt()
    {
        _studentAnswers = new Dictionary<Guid, string>();
        _quizSubmitResult = null;
        _timeExpired = false;
        if (!_isTeacher && _viewedQuiz != null && _viewedQuiz.Questions.Count > 0 && _viewedQuiz.TimeLimitMinutes > 0)
        {
            StartTimer(_viewedQuiz.TimeLimitMinutes * 60);
        }
    }

    private async Task SubmitStudentQuiz(bool autoSubmit)
    {
        if (_viewedQuiz == null) return;

        if (!autoSubmit)
        {
            var unanswered = _viewedQuiz.Questions.Count(q =>
                !_studentAnswers.ContainsKey(q.Id) || string.IsNullOrEmpty(_studentAnswers[q.Id]));
            if (unanswered > 0)
            {
                Snackbar.Add($"Mai ai {unanswered} întrebări fără răspuns.", Severity.Warning);
                return;
            }
        }

        StopTimer();
        _isSaving = true;

        var answers = _viewedQuiz.Questions.Select(q => new QuizAnswerDto
        {
            QuestionId = q.Id,
            Answer = _studentAnswers.ContainsKey(q.Id) ? _studentAnswers[q.Id] ?? string.Empty : string.Empty
        }).ToList();

        var request = new SubmitClassroomQuizRequest { Answers = answers };

        var result = await ApiService.SubmitClassroomQuizAsync(
            ClassroomId, _viewedQuiz.Id, _userId, request);
        _isSaving = false;

        if (result != null)
        {
            _quizSubmitResult = result;
            if (!autoSubmit)
            {
                Snackbar.Add($"Quiz trimis! Scor: {(int)Math.Round(result.ScorePercentage)}%", Severity.Success);
            }
            await LoadProgress();
        }
        else
        {
            Snackbar.Add("Eroare la trimiterea quiz-ului.", Severity.Error);
        }
        StateHasChanged();
    }

