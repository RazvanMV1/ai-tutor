@page "/subscriptions"
@inject ApiService ApiService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Abonamente | AiTutor</PageTitle>

<div class="page-fade-in">
    <!-- Header -->
    <div style="background:linear-gradient(135deg,#7B1FA2,#AB47BC); border-radius:20px; padding:2rem;
                margin-bottom:2rem; position:relative; overflow:hidden;">
        <div style="position:absolute; top:-30px; right:-30px; width:160px; height:160px;
                    background:rgba(255,255,255,0.07); border-radius:50%;"></div>
        <div style="position:relative; z-index:1;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Style="color:#FFD700; font-size:36px;" />
                <MudText Typo="Typo.h4" Style="font-weight:800; color:white;">Abonamente Premium</MudText>
            </div>
            <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.85);">
                Deblochează tot potențialul platformei AiTutor
            </MudText>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudGrid>
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="4">
                    <MudPaper Class="pa-5" Style="border-radius:20px; height:420px;">
                        <MudSkeleton Width="60%" Height="28px" Class="mb-4" />
                        <MudSkeleton Width="40%" Height="44px" Class="mb-4" />
                        @for (int j = 0; j < 5; j++)
                        {
                            <MudSkeleton Width="80%" Height="16px" Class="mb-2" />
                        }
                        <MudSkeleton Width="100%" Height="48px" Class="mt-4" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (_activeSubscription != null && _activeSubscription.IsActive)
    {
        <!-- Active Subscription View -->
        <MudPaper Elevation="2" Class="pa-5 mb-4" Style="border-radius:20px; border:2px solid #388E3C;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
                <div>
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:0.75rem;">
                        <div style="width:52px; height:52px; background:rgba(56,142,60,0.1); border-radius:12px;
                                    display:flex; align-items:center; justify-content:center;">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#388E3C; font-size:30px;" />
                        </div>
                        <div>
                            <div class="active-badge pulse">
                                <div class="active-dot"></div>
                                Abonament Activ
                            </div>
                            <MudText Typo="Typo.h5" Style="font-weight:800; color:#1A1A2E; margin-top:4px;">
                                @GetSubscriptionName(_activeSubscription.Type)
                            </MudText>
                        </div>
                    </div>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Data Start</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">
                                    @_activeSubscription.StartDate.ToString("dd MMMM yyyy")
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Data Expirare</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700; color:#388E3C;">
                                    @_activeSubscription.EndDate.ToString("dd MMMM yyyy")
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Preț Plătit</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700;">
                                    @_activeSubscription.Price.ToString("F2") RON
                                </MudText>
                            </div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div style="background:#F8FFF8; border-radius:10px; padding:0.75rem 1rem;">
                                <MudText Typo="Typo.caption" Style="color:#546E7A; font-weight:600;">Zile Rămase</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:700; color:#1976D2;">
                                    @Math.Max(0, (int)(_activeSubscription.EndDate - DateTime.UtcNow).TotalDays) zile
                                </MudText>
                            </div>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="CancelSubscription" Disabled="_isCancelling"
                           Style="border-radius:10px; font-weight:700;">
                    @if (_isCancelling)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mr-2" />
                    Anulează Abonamentul
                </MudButton>
            </div>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Style="border-radius:12px;">
            <MudText Typo="Typo.body2">
                Dacă anulezi abonamentul, vei pierde accesul la funcțiile premium la expirare.
                Poți cumpăra un nou abonament oricând.
            </MudText>
        </MudAlert>
    }
    else
    {
        <!-- Plans Grid -->
        <MudText Typo="Typo.h5" Style="font-weight:700; text-align:center; margin-bottom:2rem;">
            Alege Planul Tău
        </MudText>

        <MudGrid>
            @foreach (var plan in _plans)
            {
                <MudItem xs="12" sm="6" md="4">
                    <div style="@($"position:relative; border-radius:20px; padding:2rem; height:100%; " +
                                $"background:{(plan.IsRecommended ? "linear-gradient(135deg,#7B1FA2,#AB47BC)" : "white")}; " +
                                $"box-shadow:{(plan.IsRecommended ? "0 12px 40px rgba(123,31,162,0.3)" : "0 2px 12px rgba(0,0,0,0.08)")}; " +
                                $"border:{(plan.IsRecommended ? "none" : "2px solid #F0F0F0")};")">

                        @if (plan.IsRecommended)
                        {
                            <div style="position:absolute; top:-14px; left:50%; transform:translateX(-50%);
                                        background:#FFD700; color:#1A1A2E; padding:4px 14px; border-radius:12px;
                                        font-weight:800; font-size:0.75rem; letter-spacing:0.5px;">
                                ⭐ POPULAR
                            </div>
                        }

                        <div style="text-align:center; margin-bottom:1.5rem;">
                            <div style="@($"width:64px; height:64px; border-radius:16px; margin:0 auto 1rem; " +
                                          $"background:{(plan.IsRecommended ? "rgba(255,255,255,0.2)" : plan.IconBg)}; " +
                                          $"display:flex; align-items:center; justify-content:center;")">
                                <MudIcon Icon="@plan.Icon"
                                         Style="@($"color:{(plan.IsRecommended ? "white" : plan.IconColor)}; font-size:34px;")" />
                            </div>
                            <MudText Typo="Typo.h6" Style="@($"font-weight:800; color:{(plan.IsRecommended ? "white" : "#1A1A2E")};")">
                                @plan.Name
                            </MudText>
                            <MudText Typo="Typo.body2" Style="@($"color:{(plan.IsRecommended ? "rgba(255,255,255,0.85)" : "#546E7A")}; margin-top:4px;")">
                                @plan.Tagline
                            </MudText>
                        </div>

                        <div style="text-align:center; margin-bottom:1.5rem;">
                            <MudText Typo="Typo.h3" Style="@($"font-weight:800; color:{(plan.IsRecommended ? "white" : "#1A1A2E")};")">
                                @plan.Price.ToString("F2")
                                <span style="@($"font-size:1rem; font-weight:600; color:{(plan.IsRecommended ? "rgba(255,255,255,0.85)" : "#546E7A")};")">
                                    RON
                                </span>
                            </MudText>
                            <MudText Typo="Typo.caption" Style="@($"color:{(plan.IsRecommended ? "rgba(255,255,255,0.75)" : "#90A4AE")};")">
                                @plan.Period
                            </MudText>
                        </div>

                        <div style="margin-bottom:1.5rem;">
                            @foreach (var feature in plan.Features)
                            {
                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                             Style="@($"color:{(plan.IsRecommended ? "#FFD700" : "#388E3C")}; font-size:18px;")" />
                                    <MudText Typo="Typo.body2"
                                             Style="@($"color:{(plan.IsRecommended ? "rgba(255,255,255,0.95)" : "#1A1A2E")};")">
                                        @feature
                                    </MudText>
                                </div>
                            }
                        </div>

                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   OnClick="@(() => StartCheckout(plan.Type))"
                                   Disabled="@(_processingType == plan.Type || _processingType != null)"
                                   Style="@($"border-radius:12px; height:48px; font-weight:700; " +
                                            $"background:{(plan.IsRecommended ? "white" : "#7B1FA2")}; " +
                                            $"color:{(plan.IsRecommended ? "#7B1FA2" : "white")};")">
                            @if (_processingType == plan.Type)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Se redirecționează...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
                                <span>Abonează-te</span>
                            }
                        </MudButton>
                    </div>
                </MudItem>
            }
        </MudGrid>

        <MudAlert Severity="Severity.Info" Class="mt-4" Style="border-radius:12px;">
            <MudText Typo="Typo.body2">
                <strong>Plată securizată prin Stripe.</strong> Pentru testare, folosește cardul
                <code>4242 4242 4242 4242</code>, orice dată viitoare și orice CVC.
            </MudText>
        </MudAlert>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _isCancelling = false;
    private SubscriptionType? _processingType = null;
    private SubscriptionDto? _activeSubscription;
    private List<SubscriptionDto> _allSubscriptions = new();

    private List<PlanInfo> _plans = new()
    {
        new PlanInfo
        {
            Index = 1,
            Type = SubscriptionType.ParentMonthly,
            Name = "Parent Monthly",
            Tagline = "Pentru părinți, lunar",
            Price = 49.99m,
            Period = "pe lună",
            Icon = Icons.Material.Filled.FamilyRestroom,
            IconBg = "rgba(25,118,210,0.1)",
            IconColor = "#1976D2",
            IsRecommended = false,
            Features = new()
            {
                "Acces la toate lecțiile",
                "Quiz-uri nelimitate",
                "Asistent AI Gemini",
                "Urmărire progres detaliat",
                "Suport email"
            }
        },
        new PlanInfo
        {
            Index = 2,
            Type = SubscriptionType.ParentYearly,
            Name = "Parent Yearly",
            Tagline = "Cea mai bună valoare",
            Price = 499.99m,
            Period = "pe an (economisești 100 RON)",
            Icon = Icons.Material.Filled.Star,
            IconBg = "rgba(255,215,0,0.1)",
            IconColor = "#FFD700",
            IsRecommended = true,
            Features = new()
            {
                "Tot ce include Monthly",
                "2 luni gratuite",
                "Suport prioritar",
                "Conținut premium exclusiv",
                "Acces beta la noi funcții"
            }
        },
        new PlanInfo
        {
            Index = 3,
            Type = SubscriptionType.School,
            Name = "School",
            Tagline = "Pentru școli și instituții",
            Price = 999.99m,
            Period = "pe lună",
            Icon = Icons.Material.Filled.School,
            IconBg = "rgba(123,31,162,0.1)",
            IconColor = "#7B1FA2",
            IsRecommended = false,
            Features = new()
            {
                "Până la 100 elevi",
                "Dashboard profesori",
                "Rapoarte avansate",
                "Clase virtuale nelimitate",
                "Suport dedicat 24/7"
            }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSubscriptionsAsync();
    }

    private async Task LoadSubscriptionsAsync()
    {
        _isLoading = true;
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            if (userId == Guid.Empty)
            {
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            _allSubscriptions = await ApiService.GetUserSubscriptionsAsync(userId);
            _activeSubscription = _allSubscriptions.FirstOrDefault(s => s.IsActive);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare la încărcarea abonamentelor: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StartCheckout(SubscriptionType type)
    {
        if (_processingType != null) return;

        _processingType = type;
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            if (userId == Guid.Empty)
            {
                Snackbar.Add("Trebuie să fii autentificat pentru a te abona.", Severity.Warning);
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            var response = await ApiService.CreateCheckoutSessionAsync(new CreateCheckoutSessionRequest
            {
                UserId = userId,
                SubscriptionType = type
            });

            if (response != null && !string.IsNullOrEmpty(response.CheckoutUrl))
            {
                Snackbar.Add("Te redirectăm către Stripe...", Severity.Info);
                // forceLoad: true → navigare în afara aplicației Blazor (la Stripe)
                Navigation.NavigateTo(response.CheckoutUrl, forceLoad: true);
            }
            else
            {
                Snackbar.Add("Nu s-a putut crea sesiunea de plată. Verifică dacă ai deja un abonament activ.", Severity.Error);
                _processingType = null;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
            _processingType = null;
        }
    }

    private async Task CancelSubscription()
    {
        if (_activeSubscription == null || _isCancelling) return;

        _isCancelling = true;
        try
        {
            var userId = await AuthService.GetCurrentUserIdAsync();
            var success = await ApiService.CancelSubscriptionAsync(_activeSubscription.Id, userId);

            if (success)
            {
                Snackbar.Add("Abonamentul a fost anulat. Accesul rămâne activ până la expirare.", Severity.Success);
                await LoadSubscriptionsAsync();
            }
            else
            {
                Snackbar.Add("Nu s-a putut anula abonamentul. Încearcă din nou.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Eroare: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCancelling = false;
        }
    }

    private string GetSubscriptionName(SubscriptionType type) => type switch
    {
        SubscriptionType.Free => "Gratuit",
        SubscriptionType.ParentMonthly => "Parent Monthly",
        SubscriptionType.ParentYearly => "Parent Yearly",
        SubscriptionType.School => "School",
        _ => type.ToString()
    };

    private class PlanInfo
    {
        public int Index { get; set; }
        public SubscriptionType Type { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Tagline { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string Period { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string IconBg { get; set; } = string.Empty;
        public string IconColor { get; set; } = string.Empty;
        public bool IsRecommended { get; set; }
        public List<string> Features { get; set; } = new();
    }
}
